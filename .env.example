# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Netlify DB / Neon, Supabase, or any Postgres 14+).
# Leave empty for local development: an embedded PGlite database is created in ./.data.
DATABASE_URL=

# ─── AI provider ─────────────────────────────────────────────────────────────
# Without a key PostPilot runs in clearly labelled demo mode (template-based sample content).
ANTHROPIC_API_KEY=
# anthropic (default when a key is set) | demo (force demo mode)
AI_PROVIDER=
# Optional overrides
AI_MODEL=claude-opus-5-5
# low | medium | high – higher effort is slower and more expensive.
AI_EFFORT=low

# ─── Product ─────────────────────────────────────────────────────────────────
# During the beta every feature is unlocked; plan usage limits still apply.
# Set to "false" once billing is live to enforce per-plan feature gating.
POSTPILOT_BETA_ALL_FEATURES=true
# Time zone used for "today", the calendar and monthly usage periods.
NEXT_PUBLIC_APP_TIME_ZONE=Europe/Berlin
