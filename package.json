{
  "name": "postpilot",
  "version": "0.1.0",
  "private": true,
  "description": "PostPilot – KI-gestützte Social-Media-Planung für kleine Unternehmen",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
