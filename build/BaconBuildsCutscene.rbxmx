		play(SFX.boom, 0.4, 1.6)
	end },
	{ 21.20, function() burstConfetti(at(HX - 9, GY + 16, 8), 55, 44); play(SFX.boing, 0.4, 1.5) end },
	{ 22.30, function() burstConfetti(at(HX + 9, GY + 16, 8), 55, 44); play(SFX.boing, 0.4, 1.7) end },

	{ 23.90, function() play(SFX.whoosh, 0.5, 0.9) end },
	{ 24.35, function() play(SFX.step, 0.4, 1.2) end },
	{ 24.80, function() play(SFX.step, 0.4, 1.1) end },
	{ 25.25, function() play(SFX.step, 0.4, 1.25) end },

	{ 25.95, function()
		play(SFX.wow, 0.7)
		bacon.bubble.Enabled = true
		bacon.bubbleText.Text = "?!"
	end },
	{ 26.40, function() burstSparkle(at(NX, GY + 28, 12), 50, 26) end },
	{ 26.90, function()
		bacon.bubbleText.Text = "WOW"
		burstSparkle(at(NX, GY + 16, 14), 40, 22)
		play(SFX.ding, 0.7, 0.9)
	end },

	{ 28.20, function()
		bacon.bubble.Enabled = false
		titleHolder.Visible = true
		addShake(1.4)
		play(SFX.boom, 0.55, 1.1)
		play(SFX.ding, 0.9, 1.0)
		burstConfetti(at(HX, GY + 26, 12), 120, 60)
		burstConfetti(at(NX, GY + 32, 12), 120, 60)
		burstConfetti(at(48, GY + 34, 16), 120, 60)
	end },
	{ 29.10, function() burstConfetti(at(34, GY + 28, 14), 80, 52); play(SFX.ding, 0.5, 1.3) end },
	{ 29.50, function() burstConfetti(at(62, GY + 28, 14), 80, 52) end },
}

for _, g in ipairs(buildGroups) do
	local isBig = (g.name == "Roof")
	table.insert(EVENTS, { g.land, function()
		addShake(isBig and 2.4 or 1.3)
		local p = g.home.Position
		burstDust(CFrame.new(p.X, ORIGIN.Position.Y + GY + 1, p.Z), isBig and 50 or 26, isBig and 34 or 24)
		burstSparkle(CFrame.new(p), isBig and 30 or 14, 14)
		play(SFX.whack, isBig and 0.85 or 0.6, isBig and 0.7 or (0.95 + math.random() * 0.3))
		play(SFX.snap, 0.5, 1.1)
		if isBig then
			play(SFX.boom, 0.45, 1.2)
			burstConfetti(CFrame.new(p) * CFrame.new(0, 6, 0), 50, 44)
		end
	end })
end

table.sort(EVENTS, function(a, b) return a[1] < b[1] end)

----------------------------------------------------------------------
-- POSING
----------------------------------------------------------------------
local function walkCycle(rig, t, speed, amp)
	local p = t * speed
	rig.legRRot =  math.sin(p) * amp
	rig.legLRot = -math.sin(p) * amp
	rig.armRRot = -math.sin(p) * amp * 0.8
	rig.armLRot =  math.sin(p) * amp * 0.8
	rig.bob = -math.abs(math.sin(p)) * 0.35
	rig.bodyRot = 0.05
end

local function swingAngle(t, land)
	if t < land - 0.24 or t > land + 0.34 then return nil end
	if t <= land then
		return lerp(-2.6, 0.85, eIn(inv(t, land - 0.24, land)))
	end
	return lerp(0.85, -2.2, eOut(inv(t, land, land + 0.34)))
end

local BUILD_WALK = {
	{ 10.4, 18 }, { 11.0, 20 }, { 11.9, 15 }, { 12.8, 19 }, { 13.5, 14 },
	{ 14.1, 31 }, { 15.0, 25 }, { 15.9, 32 }, { 16.7, 12 }, { 17.4, 19 },
	{ 18.1, 24 }, { 18.8, 13 }, { 19.3, 24 },
}

local function poseBacon(t)
	local b = bacon
	b.x, b.y, b.z = 0, 0, LANE
	b.bob, b.bodyRot, b.headRot = 0, 0, 0
	b.facing = 1
	b.armLRot, b.armRRot = 0.1, -0.1
	b.legLRot, b.legRRot = 0, 0
	b.hammerRot = 0

	if t < 0.86 then
		b.y = 14
	elseif t < 1.28 then
		b.y = lerp(14, 0, eIn(inv(t, 0.86, 1.28)))
		b.armRRot, b.armLRot = -1.6, 1.6
		b.legRRot, b.legLRot = 0.5, -0.5
	elseif t < 1.75 then
		local k = inv(t, 1.28, 1.75)
		b.y = -0.45 * math.exp(-k * 7) * math.cos(k * 22)
		b.armRRot = -1.3 + k
		b.armLRot =  1.3 - k
	elseif t < 3.5 then
		local k = inv(t, 1.75, 3.5)
		b.headRot = math.sin(k * 7) * 0.22
		local hop = (k > 0.45) and math.max(0, math.sin((k - 0.45) * 9)) * 2.2 or 0
		b.y = hop
		b.armRRot = -0.5 - math.sin(t * 7) * 0.5
		b.armLRot =  0.5 + math.sin(t * 7) * 0.5
		b.legRRot =  hop * 0.12
		b.legLRot = -hop * 0.12
	elseif t < 4.86 then
		b.x = track({ { 3.5, 0 }, { 4.86, 11.4 } }, t)
		walkCycle(b, t, 11, 0.52)
	elseif t < 5.10 then
		b.x = 11.4
		local k = inv(t, 4.86, 5.10)
		b.armRRot = lerp(-0.2, -2.5, eOut(k))
		b.bodyRot = -k * 0.12
	elseif t < 5.34 then
		b.x = 11.4
		local k = inv(t, 5.10, 5.34)
		b.armRRot = lerp(-2.5, 1.35, eOut(k))
		b.bodyRot = k * 0.16
	elseif t < 7.20 then
		b.x = 11.4
		local k = inv(t, 5.34, 7.20)
		local j = math.max(0, math.sin(k * math.pi * 2.4)) * 2.8
		b.y = j
		b.armRRot, b.armLRot = -2.3, 2.3
		b.legRRot, b.legLRot = j * 0.12, -j * 0.12
		b.bodyRot = math.sin(k * 14) * 0.05
	elseif t < 7.62 then
		b.x = track({ { 7.20, 11.4 }, { 7.62, 16 } }, t)
		walkCycle(b, t, 10, 0.4)
	elseif t < 8.56 then
		b.x = 16
		local k = inv(t, 7.62, 8.56)
		b.armRRot = lerp(-0.1, 0.55, eIO(math.min(1, k * 2)))
		b.bodyRot = 0.08 + math.sin(t * 16) * 0.035
		b.headRot = 0.16
	elseif t < 10.40 then
		b.x = 16
		local k = inv(t, 8.56, 8.95)
		b.armRRot = lerp(0.55, -2.45, eBack(k))
		b.hammerRot = lerp(1.6, 0, eBack(k)) + math.sin(t * 2) * 0.06
		b.armLRot = lerp(0.1, 0.85, k)
		b.bodyRot = -0.07
		b.headRot = -0.10
		b.y = math.abs(math.sin((t - 8.9) * 2)) * 0.4
	elseif t < 19.50 then
		b.x = track(BUILD_WALK, t)
		local sw
		for _, g in ipairs(buildGroups) do
			sw = swingAngle(t, g.land)
			if sw then break end
		end
		b.armRRot = sw or (-2.1 + math.sin(t * 3) * 0.12)
		b.hammerRot = sw and 0 or math.sin(t * 3) * 0.1
		b.armLRot = 0.35
		b.legRRot =  math.sin(t * 9) * 0.16
		b.legLRot = -math.sin(t * 9) * 0.16
		b.bob = -math.abs(math.sin(t * 9)) * 0.22
		b.bodyRot = (sw and sw > 0) and 0.14 or -0.04
	elseif t < 19.72 then
		b.x = 24
		b.armRRot = -1.2
	elseif t < 23.70 then
		local p = t - 19.72
		b.x = 24 + math.sin(p * 2.6) * 3.4
		local j = math.max(0, math.sin(p * 5.4)) * 3.0
		b.y = j
		b.armRRot = -2.2 + math.sin(p * 10.8) * 0.9
		b.armLRot =  2.2 + math.sin(p * 10.8 + 1) * 0.9
		b.legRRot =  math.sin(p * 10.8) * 0.6
		b.legLRot = -math.sin(p * 10.8) * 0.6
		b.bodyRot = math.sin(p * 5.4) * 0.17
		b.headRot = math.sin(p * 10.8) * 0.2
		b.facing = (math.sin(p * 2.6) > 0) and 1 or -1
		if p > 3.4 then b.facing = 1 end
	elseif t < 25.85 then
		b.x = track({ { 23.70, 24 }, { 25.85, 60 } }, t)
		b.z = track({ { 23.70, LANE }, { 25.85, 30 } }, t)
		walkCycle(b, t, 17, 0.74)
		b.bodyRot = 0.14
	else
		b.x, b.z = 60, 30
		local k = inv(t, 25.85, 26.60)
		b.headRot = lerp(0, -0.42, eOut(k))
		local a = eOut(inv(t, 26.10, 26.70))
		b.armRRot = lerp(-0.1, -1.5, a)
		b.armLRot = lerp( 0.1,  1.5, a)
		b.y = math.abs(math.sin((t - 26.6) * 4)) * 0.6
		if t > 28.20 then
			local q = inv(t, 28.20, 28.70)
			b.headRot = lerp(-0.42, 0, q)
			b.armRRot = -2.3 + math.sin(t * 9) * 0.35
			b.armLRot = 1.6
			b.y = math.abs(math.sin(t * 5)) * 1.1
		end
	end
end

local function poseNeighbour(t)
	local n = neighbour
	n.x, n.z, n.facing = 80, 24, -1
	n.bob = -math.abs(math.sin(t * 2.2)) * 0.25
	n.armLRot = 0.12
	n.armRRot = (t > 25.4) and (-2.5 + math.sin(t * 9) * 0.45) or -0.1
	if t > 28.2 then
		n.armLRot = -2.3 + math.sin(t * 9 + 2) * 0.3
		n.bob = -math.abs(math.sin(t * 5 + 1)) * 1.1
	end
end

----------------------------------------------------------------------
-- PER-FRAME WORLD UPDATES
----------------------------------------------------------------------
local function updateBeam(t)
	if t >= 1.4 then
		beam.Transparency = 1
		return
	end
	local k = inv(t, 0.1, 0.5)
	local out = inv(t, 0.9, 1.4)
	local r = lerp(2, 8, k) * (1 - out * 0.4)
	beam.Transparency = math.min(1, lerp(1, 0.35, k) + out * 0.65)
	beam.Size = Vector3.new(70, r, r)
	beam.CFrame = at(0, GY + 35, LANE) * CFrame.Angles(0, 0, math.pi / 2) * CFrame.Angles(0, t * 3, 0)
end

local function updateSign(t)
	if claimed then
		local k = inv(t, 5.10, 5.90)
		local spin = lerp(math.pi * 4, 0, eOut(k))
		local lean = math.sin((t - 5.10) * 9) * math.exp(-(t - 5.10) * 3) * 0.18
		signBoard.CFrame = signHome * CFrame.Angles(0, spin, lean)
	end
	local pulse = 0.2 + math.abs(math.sin(t * 3)) * 0.35
	local faded = inv(t, 11.2, 12.4)
	for _, p in ipairs(plotMarks) do
		p.Transparency = math.max(pulse, faded)
	end
end

local function updateBuild(t)
	for _, g in ipairs(buildGroups) do
		local start = g.land - 0.45
		if t < start then
			if g.shown then
				for _, d in ipairs(g.model:GetDescendants()) do
					if d:IsA("BasePart") then d.Transparency = 1 end
				end
				g.shown = false
			end
		else
			if not g.shown then
				for _, d in ipairs(g.model:GetDescendants()) do
					if d:IsA("BasePart") then
						d.Transparency = (d.Material == Enum.Material.Glass) and 0.3 or 0
					end
				end
				g.shown = true
			end

			local pivot
			local idleCF = g.idle and g.idle(t, g.home) or nil
			if idleCF then
				pivot = idleCF
			else
				local k = eBack(inv(t, start, g.land))
				local off = g.from * (1 - k)
				local rot = g.rot * (1 - k)
				pivot = CFrame.new(g.home.Position + off) * CFrame.Angles(rot.X, rot.Y, rot.Z)
			end

			local u = t - g.land
			if u >= 0 and u < 0.35 then
				pcall(function() g.model:ScaleTo(1 + 0.16 * math.sin(u / 0.35 * math.pi)) end)
			elseif u >= 0.35 and u < 0.52 then
				pcall(function() g.model:ScaleTo(1) end)
			end

			g.model:PivotTo(pivot)
		end
	end
end

local function updateHouseLife(t)
	if t > 19.3 then
		local a = lerp(0, -1.15, eBack(inv(t, 19.3, 19.9)))
		for _, s in ipairs(shutters) do
			s.part.CFrame = s.hinge * CFrame.Angles(0, a * s.dir, 0) * s.off
		end
	end
	if flagCloth and flagCloth.Transparency < 1 then
		local w = math.sin(t * 6) * 0.3
		flagCloth.CFrame = FLAG_HOME * CFrame.Angles(w, 0, w * 0.25)
	end
	if t > 19.0 then
		local glow = 0.3 + math.sin(t * 2) * 0.12
		for _, g in ipairs(houseGlass) do
			g.Material = Enum.Material.Neon
			g.Color = C.glass:Lerp(C.warm, 0.55 + glow * 0.3)
			g.Transparency = 0.1
		end
	end
end

local function updateMansionLife(t)
	for _, v in ipairs(vanes) do
		v.part.CFrame = v.home * CFrame.Angles(0, t * 1.6, 0)
	end
	for i, f in ipairs(mansionFlags) do
		local w = math.sin(t * 6 + i) * 0.34
		f.part.CFrame = f.home * CFrame.Angles(w, 0, w * 0.3)
	end
	for i, h in ipairs(hedges) do
		h.part.CFrame = h.home * CFrame.Angles(0, 0, math.sin(t * 1.6 + i) * 0.05)
	end
	local glow = 0.3 + math.sin(t * 2.2) * 0.12
	for _, w in ipairs(mansionLights) do
		w.Color = C.warm:Lerp(Color3.fromRGB(255, 248, 214), glow)
	end
	for _, j in ipairs(fountainJets) do
		local ph = (t * 1.7 + j.phase) % 1
		local x = j.cx + j.side * ph * 5.2
		local y = GY + 6 + math.sin(ph * math.pi) * 4.6 - ph * ph * 1.4
		j.part.CFrame = at(x, y, j.cz)
		j.part.Transparency = ph * 0.7
	end
end

local function updateCaptions(t)
	for _, c in ipairs(CAPTIONS) do
		if t >= c[1] and t <= c[2] then
			local ins  = inv(t, c[1], c[1] + 0.34)
			local outs = inv(t, c[2] - 0.26, c[2])
			caption.Text = c[3]
			caption.TextColor3 = c[4]
			caption.TextTransparency = outs
			caption.TextStrokeTransparency = outs
			captionScale.Scale = math.max(0.01, eBack(ins) * (1 - outs * 0.5))
			caption.Rotation = math.sin(t * 7) * 1.4 - 1.5
			return
		end
	end
	caption.TextTransparency = 1
	caption.TextStrokeTransparency = 1
end

local function updateTitle(t)
	if t < 28.2 then return end
	titleScale.Scale = math.max(0.01, eElastic(inv(t, 28.2, 29.0)))
	titleText.Rotation = math.sin(t * 4) * 0.8
	local k2 = inv(t, 28.7, 29.3)
	tagline.TextTransparency = 1 - k2
	tagline.TextStrokeTransparency = 1 - k2
	taglineScale.Scale = math.max(0.01, eBack(k2))
end

----------------------------------------------------------------------
-- RUNTIME
----------------------------------------------------------------------
local running = false
local conn
local savedCameraType
local hidden = {}
local anchoredRoot = nil
local charConn

local function hideCharacter(on)
	if not CONFIG.HideLocalCharacter then return end
	local char = player.Character
	if not char then return end
	if on then
		-- anchor the root: a character that falls out of the world dies, respawns,
		-- and the respawn hands the camera back to the default camera module
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if hrp then
			anchoredRoot = { hrp, hrp.Anchored }
			hrp.Anchored = true
		end
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("BasePart") then
				table.insert(hidden, { d, d.LocalTransparencyModifier })
				d.LocalTransparencyModifier = 1
			elseif d:IsA("Decal") then
				table.insert(hidden, { d, d.Transparency })
				d.Transparency = 1
			end
		end
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.WalkSpeed = 0
			hum.JumpPower = 0
			hum.JumpHeight = 0
		end
	else
		for _, rec in ipairs(hidden) do
			local inst, val = rec[1], rec[2]
			if inst and inst.Parent then
				if inst:IsA("BasePart") then
					inst.LocalTransparencyModifier = val
				else
					inst.Transparency = val
				end
			end
		end
		hidden = {}
		if anchoredRoot and anchoredRoot[1] and anchoredRoot[1].Parent then
			anchoredRoot[1].Anchored = anchoredRoot[2]
		end
		anchoredRoot = nil
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.WalkSpeed = 16
			hum.JumpPower = 50
			hum.JumpHeight = 7.2
		end
	end
end

local RENDER_NAME = "BaconBuildsCutsceneCamera"

local finished = false
local function finish()
	if finished then return end
	finished = true
	running = false
	pcall(function() RunService:UnbindFromRenderStep(RENDER_NAME) end)
	if conn then conn:Disconnect(); conn = nil end
	if charConn then charConn:Disconnect(); charConn = nil end
	if music then music:Stop(); music:Destroy(); music = nil end

	local cam = workspace.CurrentCamera
	if cam then
		cam.CameraType = savedCameraType or Enum.CameraType.Custom
		cam.FieldOfView = 70
	end
	hideCharacter(false)
	popLighting()

	if gui then gui:Destroy() end
	if ROOT then ROOT:Destroy() end
end

if skipBtn then
	skipBtn.MouseButton1Click:Connect(finish)
end

local function run()
	if running or finished then return end
	running = true

	local cam = workspace.CurrentCamera
	savedCameraType = cam.CameraType
	cam.CameraType = Enum.CameraType.Scriptable

	pushLighting()
	hideCharacter(true)
	startMusic()
	chimneySmoke = makeSmokeStack(CHIMNEY_TOP)

	-- a respawn mid-cutscene hands the camera back and un-hides the avatar
	charConn = player.CharacterAdded:Connect(function()
		task.wait(0.25)
		if running then
			hidden = {}
			hideCharacter(true)
		end
	end)

	if CONFIG.Debug then
		local n = 0
		for _, d in ipairs(ROOT:GetDescendants()) do
			if d:IsA("BasePart") then n += 1 end
		end
		print(("[BaconBuilds] %d parts built at Y=%d | camera start %s")
			:format(n, CONFIG.BuildHeight, tostring((ORIGIN.Position + CAM[1][2]))))
	end

	local t = 0
	local nextEvent = 1

	-- Bound ABOVE the default camera module. RunService.RenderStepped fires before
	-- the PlayerModule's camera step, so a CFrame written there is overwritten the
	-- same frame and the shot never leaves the player's own view.
	local function step(dt)
		if not running then return end
		cam = workspace.CurrentCamera
		if not cam then return end
		if cam.CameraType ~= Enum.CameraType.Scriptable then
			cam.CameraType = Enum.CameraType.Scriptable
		end
		t = math.min(t + dt, DURATION)

		while nextEvent <= #EVENTS and EVENTS[nextEvent][1] <= t do
			local ok, err = pcall(EVENTS[nextEvent][2])
			if not ok then warn("[BaconBuilds] event error: " .. tostring(err)) end
			nextEvent += 1
		end

		updateBeam(t)
		updateSign(t)
		updateBuild(t)
		updateHouseLife(t)
		updateMansionLife(t)

		poseBacon(t)
		poseNeighbour(t)
		applyRig(bacon)
		applyRig(neighbour)

		local pos, look, fov = cameraAt(t)
		local cf = CFrame.lookAt(ORIGIN.Position + pos, ORIGIN.Position + look)
		if shake > 0.01 then
			cf = cf
				* CFrame.new((math.random() - 0.5) * shake, (math.random() - 0.5) * shake, 0)
				* CFrame.Angles(0, 0, (math.random() - 0.5) * shake * 0.02)
			shake *= math.max(0, 1 - dt * 6)
		else
			shake = 0
		end
		cam.CFrame = cf
		cam.FieldOfView = fov

		if t < 0.45 then
			fade.BackgroundTransparency = 1 - inv(t, 0, 0.45)
		elseif t > 29.72 then
			fade.BackgroundTransparency = 1 - inv(t, 29.72, 30)
		else
			fade.BackgroundTransparency = 1
		end

		updateCaptions(t)
		updateTitle(t)

		if t >= DURATION then
			running = false
			task.delay(0.25, finish)
		end
	end

	RunService:BindToRenderStep(RENDER_NAME, Enum.RenderPriority.Camera.Value + 10, step)
end

----------------------------------------------------------------------
-- START
----------------------------------------------------------------------
if CONFIG.AutoPlay then
	task.delay(CONFIG.StartDelay, run)
end

-- Trigger it from anywhere with:  workspace:SetAttribute("PlayBaconCutscene", true)
workspace:GetAttributeChangedSignal("PlayBaconCutscene"):Connect(function()
	if workspace:GetAttribute("PlayBaconCutscene") then run() end
end)
]]></ProtectedString>
    </Properties>
  </Item>
</roblox>
