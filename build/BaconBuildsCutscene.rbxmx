		table.insert(plotMarks, newPart(SET, Vector3.new(1.6, 0.2, 0.6), at(HX + x, GY + 0.15,  d / 2), C.white, Enum.Material.Neon))
	end
	for z = -d / 2, d / 2, 3 do
		table.insert(plotMarks, newPart(SET, Vector3.new(0.6, 0.2, 1.6), at(HX - w / 2, GY + 0.15, z), C.white, Enum.Material.Neon))
		table.insert(plotMarks, newPart(SET, Vector3.new(0.6, 0.2, 1.6), at(HX + w / 2, GY + 0.15, z), C.white, Enum.Material.Neon))
	end
end

