----------------------------------------------------------------------
-- THE HOUSE: eleven groups, each lands on its own beat
----------------------------------------------------------------------
local buildGroups = {}
local shutters = {}
local houseGlass = {}
local flagCloth

local function group(name, land, fromOffset, fromRot, builder, idle)
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = HOUSE
	builder(m)
	local entry = {
		name  = name,
		model = m,
		land  = land,
		home  = m:GetPivot(),
		from  = fromOffset,
		rot   = fromRot,
		idle  = idle,
		shown = false,
	}
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then d.Transparency = 1 end
	end
	table.insert(buildGroups, entry)
	return entry
end

-- 1. foundation
group("Foundation", 11.0, Vector3.new(0, 60, 0), Vector3.new(0, 0, 0), function(m)
	newPart(m, Vector3.new(22, 1.6, 16), at(HX, GY + 0.8, 0), C.stone, Enum.Material.Slate)
end)

-- 2. walls
group("Walls", 11.9, Vector3.new(-48, 22, 0), Vector3.new(0, 0, -0.7), function(m)
	local h = 9
	local midY = GY + 1.6 + h / 2
	newPart(m, Vector3.new(20, h, 0.8), at(HX, midY,  7), C.wall)
	newPart(m, Vector3.new(20, h, 0.8), at(HX, midY, -7), C.wall)
	newPart(m, Vector3.new(0.8, h, 14.8), at(HX - 10, midY, 0), C.wall)
	newPart(m, Vector3.new(0.8, h, 14.8), at(HX + 10, midY, 0), C.wall)
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			newPart(m, Vector3.new(1.1, h, 1.1), at(HX + sx * 10, midY, sz * 7), C.wood, Enum.Material.Wood)
		end
	end
	newPart(m, Vector3.new(21, 0.9, 15.4), at(HX, GY + 1.6 + h, 0), C.wood, Enum.Material.Wood)
end)

-- 3. door, hinged on its left edge, breathes open later
local DOOR_HINGE = at(HX - 2, GY + 4.8, 7.2)
group("Door", 12.8, Vector3.new(0, -24, 0), Vector3.new(0, 0, 0.9), function(m)
	newPart(m, Vector3.new(4, 6.4, 0.5), at(HX, GY + 4.8, 7.2), C.wood, Enum.Material.WoodPlanks)
	newPart(m, Vector3.new(0.6, 0.6, 0.6), at(HX + 1.4, GY + 4.6, 7.6), C.gold, Enum.Material.Metal, Enum.PartType.Ball)
end, function(t, home)
	if t < 19.6 then return nil end
	local sw = math.sin(t * 2.2) * 0.16
	local hp = DOOR_HINGE.Position
	return CFrame.new(hp) * CFrame.Angles(0, sw, 0) * CFrame.new(home.Position - hp)
end)

-- 4 & 5. windows, with shutters that swing open in the dance shot
local function windowGroup(name, land, sx, fromOffset, fromRot)
	group(name, land, fromOffset, fromRot, function(m)
		local wx, wy = HX + sx * 6, GY + 7.4
		local glass = newPart(m, Vector3.new(4.2, 4.2, 0.4), at(wx, wy, 7.1), C.glass, Enum.Material.Glass)
		table.insert(houseGlass, glass)
		newPart(m, Vector3.new(4.8, 0.5, 0.6), at(wx, wy + 2.2, 7.25), C.white)
		newPart(m, Vector3.new(4.8, 0.5, 0.6), at(wx, wy - 2.2, 7.25), C.white)
		newPart(m, Vector3.new(0.5, 4.8, 0.6), at(wx - 2.2, wy, 7.25), C.white)
		newPart(m, Vector3.new(0.5, 4.8, 0.6), at(wx + 2.2, wy, 7.25), C.white)
		newPart(m, Vector3.new(0.35, 4.2, 0.35), at(wx, wy, 7.35), C.white)
		newPart(m, Vector3.new(4.2, 0.35, 0.35), at(wx, wy, 7.35), C.white)
		for _, side in ipairs({ -1, 1 }) do
			local sh = newPart(m, Vector3.new(1.6, 4.6, 0.45), at(wx + side * 2.9, wy, 7.45), C.tomato, Enum.Material.WoodPlanks)
			table.insert(shutters, {
				part = sh,
				hinge = at(wx + side * 2.1, wy, 7.45),
				off = CFrame.new(side * 0.8, 0, 0),
				dir = side,
			})
		end
	end)
end
windowGroup("WindowLeft",  13.5, -1, Vector3.new(-36, 16, 0), Vector3.new(0, 0,  1.3))
windowGroup("WindowRight", 14.1,  1, Vector3.new( 36, 16, 0), Vector3.new(0, 0, -1.3))

-- 6. roof, the big beat
group("Roof", 15.0, Vector3.new(0, 70, 0), Vector3.new(0.35, 0, 0), function(m)
	local topY = GY + 11.5
	for _, sz in ipairs({ -1, 1 }) do
		wedge(m, Vector3.new(22, 7, 9),
			at(HX, topY + 3.5, sz * 4.5)
				* CFrame.Angles(0, sz > 0 and 0 or math.pi, 0)
				* CFrame.Angles(0, math.pi / 2, 0),
			C.roof, Enum.Material.Slate)
	end
	newPart(m, Vector3.new(23, 0.8, 17), at(HX, topY + 0.3, 0), C.roofDk, Enum.Material.Slate)
	newPart(m, Vector3.new(23, 0.9, 0.9), at(HX, topY + 7.1, 0), C.roofDk, Enum.Material.Slate)
end)

-- 7. chimney
local CHIMNEY_TOP = at(HX + 6.5, GY + 20.4, -2.5)
group("Chimney", 15.9, Vector3.new(24, 40, 0), Vector3.new(0, 0, 1.6), function(m)
	newPart(m, Vector3.new(2.6, 6, 2.6), at(HX + 6.5, GY + 16.4, -2.5), C.roofDk, Enum.Material.Brick)
	newPart(m, Vector3.new(3.4, 0.9, 3.4), at(HX + 6.5, GY + 19.6, -2.5), Color3.fromRGB(142, 64, 54), Enum.Material.Brick)
end)

-- 8. picket fence
group("Fence", 16.7, Vector3.new(0, -30, 0), Vector3.new(0, 0, 0), function(m)
	for _, sx in ipairs({ -1, 1 }) do
		for i = 0, 4 do
			local x = HX + sx * (13 + i * 2.4)
			newPart(m, Vector3.new(0.6, 3.4, 1.4), at(x, GY + 1.7, 8.5), C.white, Enum.Material.WoodPlanks)
			wedge(m, Vector3.new(1.4, 0.8, 0.6), at(x, GY + 3.8, 8.5) * CFrame.Angles(0, math.pi / 2, 0), C.white, Enum.Material.WoodPlanks)
		end
		newPart(m, Vector3.new(11.4, 0.5, 0.35), at(HX + sx * 18, GY + 2.6, 8.5), C.white, Enum.Material.WoodPlanks)
	end
end)

-- 9. garden path and flower beds
group("Garden", 17.4, Vector3.new(0, -26, 0), Vector3.new(0, 0, 0), function(m)
	for i = 0, 4 do
		newPart(m, Vector3.new(3.4 - i * 0.2, 0.3, 2), at(HX, GY + 0.2, 9.6 + i * 2.2), C.path, Enum.Material.Slate)
	end
	for _, sx in ipairs({ -1, 1 }) do
		local bx = HX + sx * 7.5
		newPart(m, Vector3.new(4, 1.6, 4), at(bx, GY + 0.8, 10), C.hedge, Enum.Material.Grass, Enum.PartType.Ball)
		for j = 1, 4 do
			local a = j * math.pi / 2
			newPart(m, Vector3.new(0.9, 0.9, 0.9),
				at(bx + math.cos(a) * 1.2, GY + 1.9, 10 + math.sin(a) * 1.2),
				(j % 2 == 0) and C.tomato or C.gold, Enum.Material.Neon, Enum.PartType.Ball)
		end
	end
end)

