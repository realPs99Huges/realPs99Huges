----------------------------------------------------------------------
-- CAMERA
----------------------------------------------------------------------
local CAM = {
	{  0.0, Vector3.new(  2, 10, 48), Vector3.new(  0,  5, 14), 70 },
	{  1.2, Vector3.new( -6,  7, 32), Vector3.new(  0,  4, 14), 62 },
	{  3.0, Vector3.new( -2,  6, 30), Vector3.new(  2,  4, 14), 64 },
	{  3.6, Vector3.new(  2,  6, 32), Vector3.new(  6,  4, 14), 66 },
	{  5.0, Vector3.new( 10,  6, 26), Vector3.new( 14,  5, 14), 52 },
	{  7.2, Vector3.new( 13,  6, 28), Vector3.new( 14,  4, 14), 58 },
	{  7.6, Vector3.new( 16,  1.6, 26), Vector3.new( 16,  5, 14), 48 },
	{  9.2, Vector3.new( 17,  1.2, 24), Vector3.new( 17,  6, 14), 44 },
	{ 10.4, Vector3.new( 24, 18, 62), Vector3.new( 24,  8,  4), 74 },
	{ 14.0, Vector3.new( 36, 20, 60), Vector3.new( 24,  9,  4), 76 },
	{ 17.6, Vector3.new( 12, 16, 58), Vector3.new( 24,  9,  4), 74 },
	{ 19.6, Vector3.new( 22, 12, 48), Vector3.new( 24,  6,  6), 68 },
	{ 22.4, Vector3.new( 28,  9, 40), Vector3.new( 24,  5,  8), 62 },
	{ 23.8, Vector3.new( 36, 11, 46), Vector3.new( 40,  5, 12), 70 },
	{ 25.4, Vector3.new( 46, 12, 60), Vector3.new( 72, 12, 12), 72 },
	{ 26.6, Vector3.new( 48,  6, 48), Vector3.new( 70, 20,  8), 60 },
	{ 27.6, Vector3.new( 50,  8, 50), Vector3.new( 70, 15,  8), 64 },
	{ 28.2, Vector3.new( 48, 32, 104), Vector3.new( 48, 10,  4), 82 },
	{ 30.0, Vector3.new( 48, 34, 110), Vector3.new( 48, 10,  4), 84 },
}

local function cameraAt(t)
	for i = 1, #CAM - 1 do
		local a, b = CAM[i], CAM[i + 1]
		if t <= b[1] then
			local k = eIO(inv(t, a[1], b[1]))
			return a[2]:Lerp(b[2], k), a[3]:Lerp(b[3], k), lerp(a[4], b[4], k)
		end
	end
	local last = CAM[#CAM]
	return last[2], last[3], last[4]
end

