----------------------------------------------------------------------
-- LIGHTING
----------------------------------------------------------------------
local savedLighting
local function pushLighting()
	if not CONFIG.OverrideLighting then return end
	savedLighting = {
		Ambient        = Lighting.Ambient,
		OutdoorAmbient = Lighting.OutdoorAmbient,
		Brightness     = Lighting.Brightness,
		ClockTime      = Lighting.ClockTime,
		FogEnd         = Lighting.FogEnd,
	}
	Lighting.Ambient        = Color3.fromRGB(120, 120, 128)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 160, 170)
	Lighting.Brightness     = 2.4
	Lighting.ClockTime      = 14.2
	Lighting.FogEnd         = 1500
end
local function popLighting()
	if not savedLighting then return end
	for k, v in pairs(savedLighting) do
		pcall(function() Lighting[k] = v end)
	end
	savedLighting = nil
end

