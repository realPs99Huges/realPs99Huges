<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
  <Item class="LocalScript" referent="RBX_BaconBuildsCutscene">
    <Properties>
      <string name="Name">BaconBuildsCutscene</string>
      <bool name="Disabled">false</bool>
      <ProtectedString name="Source"><![CDATA[--[[
	BACON BUILDS - 30 second cinematic cutscene
	=================================================================
	LocalScript. Put it in StarterPlayer > StarterPlayerScripts.

	Everything is built from Parts at runtime, 2000 studs above your
	map, so it never touches your game geometry. No uploads, no rig
	assets, no animation IDs. Press Play and it runs.

	Shots
	  00.0  Bacon drops in on a beam of light
	  03.6  He walks up and slaps the plot sign - CLAIMED
	  07.4  Cartoony hammer comes out of his pocket
	  10.4  Eleven whacks, one classic house
	  19.6  Happy dance, confetti, the house comes alive
	  23.8  He runs next door to the neighbour Bacon's mansion
	  28.2  Title card

	Everything worth tweaking is in CONFIG below.
=================================================================]]

----------------------------------------------------------------------
-- SERVICES
----------------------------------------------------------------------
local Players      = game:GetService("Players")
local RunService   = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local Lighting     = game:GetService("Lighting")
local Debris       = game:GetService("Debris")

local player = Players.LocalPlayer

----------------------------------------------------------------------
-- CONFIG
----------------------------------------------------------------------
local CONFIG = {
	AutoPlay           = true,   -- roll as soon as the player loads
	StartDelay         = 1.0,    -- seconds before it rolls
	BuildHeight        = 2000,   -- studs above your map that the set is built at
	HideLocalCharacter = true,   -- hide the player's avatar while it plays
	OverrideLighting   = true,   -- bright cartoon lighting, restored afterwards
	ShowSkipButton     = true,
	MasterVolume       = 0.65,

	-- Paste your own uploaded track here, e.g. "rbxassetid://1234567890".
	-- Empty means no music bed.
	MusicId            = "",
	MusicVolume        = 0.35,

	Debug              = true,   -- print a one-line sanity report to Output on start
}

local DURATION = 30

----------------------------------------------------------------------
-- SOUND
-- These files ship with Studio, so nothing needs uploading.
-- Swap any value for your own rbxassetid:// if you want.
----------------------------------------------------------------------
local SFX = {
	whoosh = "rbxasset://sounds/swoosh.wav",
	pop    = "rbxasset://sounds/clickfast.wav",
	thud   = "rbxasset://sounds/bass.wav",
	ding   = "rbxasset://sounds/electronicpingshort.wav",
	snap   = "rbxasset://sounds/snap.wav",
	whack  = "rbxasset://sounds/metal.ogg",
	boing  = "rbxasset://sounds/action_jump.mp3",
