local vanes, mansionFlags, hedges, mansionLights, fountainJets = {}, {}, {}, {}, {}

do
	newPart(MANSION, Vector3.new(36, 22, 22), at(NX, GY + 11, 0), C.cream)
	newPart(MANSION, Vector3.new(37, 0.8, 23), at(NX, GY + 11, 0), Color3.fromRGB(205, 175, 128))

	for _, sz in ipairs({ -1, 1 }) do
		wedge(MANSION, Vector3.new(38, 9, 12),
			at(NX, GY + 26.5, sz * 6)
				* CFrame.Angles(0, sz > 0 and 0 or math.pi, 0)
				* CFrame.Angles(0, math.pi / 2, 0),
			C.teal, Enum.Material.Slate)
	end
	newPart(MANSION, Vector3.new(40, 1, 25), at(NX, GY + 22.3, 0), C.tealDk, Enum.Material.Slate)

	for _, sx in ipairs({ -1, 1 }) do
		local tx = NX + sx * 22
		newPart(MANSION, Vector3.new(10, 32, 10), at(tx, GY + 16, 0), C.cream)
		for i = 0, 5 do
			local s = 13 - i * 2.1
			newPart(MANSION, Vector3.new(s, 1.8, s), at(tx, GY + 33 + i * 1.8, 0), C.teal, Enum.Material.Slate)
		end
		newPart(MANSION, Vector3.new(0.3, 4, 0.3), at(tx, GY + 45, 0), C.metal, Enum.Material.Metal)
		local vane = newPart(MANSION, Vector3.new(3.4, 0.9, 0.2), at(tx, GY + 46.6, 0), C.gold, Enum.Material.Metal)
		table.insert(vanes, { part = vane, home = vane.CFrame })

		local fl = newPart(MANSION, Vector3.new(3.4, 2, 0.2), at(tx + 1.8, GY + 44.2, 0),
			sx > 0 and C.tomato or C.gold, Enum.Material.Fabric)
		table.insert(mansionFlags, { part = fl, home = fl.CFrame })

		table.insert(mansionLights, newPart(MANSION, Vector3.new(3.6, 4.6, 0.4), at(tx, GY + 24, 5.2), C.glass, Enum.Material.Neon))
	end

	for row = 0, 1 do
		for col = 0, 3 do
			local wx, wy = NX - 13 + col * 8.6, GY + 7 + row * 9
			table.insert(mansionLights, newPart(MANSION, Vector3.new(5, 6, 0.4), at(wx, wy, 11.2), C.glass, Enum.Material.Neon))
			newPart(MANSION, Vector3.new(5.6, 0.5, 0.6), at(wx, wy + 3.1, 11.35), C.white)
			newPart(MANSION, Vector3.new(5.6, 0.5, 0.6), at(wx, wy - 3.1, 11.35), C.white)
			newPart(MANSION, Vector3.new(0.4, 6, 0.4), at(wx, wy, 11.45), C.white)
		end
	end

	newPart(MANSION, Vector3.new(18, 0.8, 3), at(NX, GY + 12.4, 12), C.trim)
	for i = 0, 8 do
		newPart(MANSION, Vector3.new(0.4, 2, 0.4), at(NX - 8 + i * 2, GY + 13.6, 13.2), C.trim)
	end

	newPart(MANSION, Vector3.new(7, 10, 0.6), at(NX, GY + 5, 11.2), C.wood, Enum.Material.WoodPlanks)
	newPart(MANSION, Vector3.new(0.6, 7, 7), at(NX, GY + 10, 11.2), C.wood, Enum.Material.WoodPlanks, Enum.PartType.Cylinder)
	newPart(MANSION, Vector3.new(0.9, 0.9, 0.9), at(NX + 2.4, GY + 5, 11.7), C.gold, Enum.Material.Metal, Enum.PartType.Ball)
	for i = 0, 2 do
		newPart(MANSION, Vector3.new(12 + i * 3, 0.8, 2.2 + i * 1.4), at(NX, GY + 0.4 + (2 - i) * 0.8, 12.6 + i * 1.5), Color3.fromRGB(217, 203, 176))
	end

	for i = -4, 4 do
		if i ~= 0 then
			local h = newPart(MANSION, Vector3.new(5, 3.4, 4), at(NX + i * 7, GY + 1.7, 18), C.hedge, Enum.Material.Grass)
			table.insert(hedges, { part = h, home = h.CFrame })
		end
	end

	-- fountain, parked clear of Bacon's run-up
	local fx, fz = NX + 2, 27
	newPart(MANSION, Vector3.new(1.4, 11, 11), at(fx, GY + 0.7, fz), C.path, Enum.Material.Slate, Enum.PartType.Cylinder)
	newPart(MANSION, Vector3.new(0.8, 9.4, 9.4), at(fx, GY + 1.4, fz), C.water, Enum.Material.Neon, Enum.PartType.Cylinder)
	newPart(MANSION, Vector3.new(1.6, 5, 1.6), at(fx, GY + 3.4, fz), C.trim)
	for i = 1, 14 do
		local p = newPart(MANSION, Vector3.new(0.7, 0.7, 0.7), at(fx, GY + 6, fz), C.water, Enum.Material.Neon, Enum.PartType.Ball)
		table.insert(fountainJets, { part = p, phase = i / 14, side = (i % 2 == 0) and 1 or -1, cx = fx, cz = fz })
	end

	for _, sx in ipairs({ -1, 1 }) do
		local lx = NX + sx * 26
		newPart(MANSION, Vector3.new(0.6, 9, 0.6), at(lx, GY + 4.5, 17), C.metal, Enum.Material.Metal)
		table.insert(mansionLights, newPart(MANSION, Vector3.new(2.2, 2.2, 2.2), at(lx, GY + 9.6, 17), Color3.fromRGB(255, 226, 150), Enum.Material.Neon, Enum.PartType.Ball))
	end
end

----------------------------------------------------------------------
-- BACON RIGS (plain parts, so no avatar or animation uploads)
----------------------------------------------------------------------
local function buildBacon(name, shirt, legs)
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = ROOT

	local rig = { model = m }

	rig.torso = newPart(m, Vector3.new(2, 2, 1), ORIGIN, shirt)
	rig.head  = newPart(m, Vector3.new(2, 1, 1), ORIGIN, C.skin)

	local hm = Instance.new("SpecialMesh")
	hm.MeshType = Enum.MeshType.Head
	hm.Scale = Vector3.new(1.25, 1.25, 1.25)
	hm.Parent = rig.head

	rig.face = Instance.new("Decal")
	rig.face.Texture = "rbxasset://textures/face.png"
	rig.face.Face = Enum.NormalId.Front
	rig.face.Parent = rig.head

	rig.armL = newPart(m, Vector3.new(1, 2, 1), ORIGIN, C.skin)
	rig.armR = newPart(m, Vector3.new(1, 2, 1), ORIGIN, C.skin)
	rig.legL = newPart(m, Vector3.new(1, 2, 1), ORIGIN, legs)
	rig.legR = newPart(m, Vector3.new(1, 2, 1), ORIGIN, legs)

	-- the bacon hair: tan slabs over the crown and down the back
	rig.hair = {}
	local hairSpec = {
		{ Vector3.new(2.15, 0.50, 1.25), CFrame.new(0,  0.62,  0.00), C.hair  },
		{ Vector3.new(2.00, 0.50, 0.70), CFrame.new(0,  0.48, -0.62) * CFrame.Angles(-0.35, 0, 0), C.hair2 },
		{ Vector3.new(1.80, 0.50, 0.70), CFrame.new(0,  0.12, -0.84) * CFrame.Angles(-0.70, 0, 0), C.hair  },
		{ Vector3.new(1.55, 0.50, 0.65), CFrame.new(0, -0.26, -0.88) * CFrame.Angles(-1.05, 0, 0), C.hair2 },
		{ Vector3.new(1.25, 0.45, 0.60), CFrame.new(0, -0.62, -0.78) * CFrame.Angles(-1.35, 0, 0), C.hair  },
		{ Vector3.new(1.10, 0.40, 0.75), CFrame.new(0,  0.52,  0.62) * CFrame.Angles( 0.45, 0, 0), C.hair  },
	}
	for _, spec in ipairs(hairSpec) do
		table.insert(rig.hair, { part = newPart(m, spec[1], ORIGIN, spec[3]), off = spec[2] })
	end

	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromScale(7, 3.2)
	bb.StudsOffset = Vector3.new(0, 2.8, 0)
	bb.AlwaysOnTop = true
	bb.Enabled = false
	bb.Adornee = rig.head
	bb.Parent = rig.head
	local bt = Instance.new("TextLabel")
	bt.Size = UDim2.fromScale(1, 1)
	bt.BackgroundTransparency = 1
	bt.Font = Enum.Font.LuckiestGuy
	bt.TextScaled = true
	bt.TextColor3 = C.gold
	bt.TextStrokeTransparency = 0
	bt.TextStrokeColor3 = Color3.fromRGB(26, 14, 8)
	bt.Text = "!"
	bt.Parent = bb
	rig.bubble, rig.bubbleText = bb, bt

	local ham = Instance.new("Model"); ham.Name = "Hammer"; ham.Parent = m
	rig.hamHandle = newPart(ham, Vector3.new(0.35, 3.2, 0.35), ORIGIN, C.wood2, Enum.Material.Wood)
	rig.hamHead   = newPart(ham, Vector3.new(3.2, 1.7, 1.7), ORIGIN, C.tomato)
	rig.hamBand   = newPart(ham, Vector3.new(1.1, 1.8, 1.8), ORIGIN, C.white)

	rig.x, rig.y, rig.z = 0, 0, LANE
	rig.facing = 1
	rig.bodyRot, rig.headRot, rig.bob = 0, 0, 0
	rig.armLRot, rig.armRRot = 0.1, -0.1
	rig.legLRot, rig.legRRot = 0, 0
	rig.hammerVisible, rig.hammerRot = false, 0

	return rig
end

local function setRigVisible(rig, on)
	local tr = on and 0 or 1
	for _, d in ipairs(rig.model:GetDescendants()) do
		if d:IsA("BasePart") then d.Transparency = tr end
	end
	rig.face.Transparency = on and 0 or 1
	if not on then rig.bubble.Enabled = false end
end

local function setHammerVisible(rig, on)
	local tr = on and 0 or 1
	rig.hamHandle.Transparency = tr
	rig.hamHead.Transparency = tr
	rig.hamBand.Transparency = tr
	rig.hammerVisible = on
end

local function applyRig(rig)
	local root = at(rig.x, GY + 3 + rig.y + rig.bob, rig.z)
		* CFrame.Angles(0, rig.facing > 0 and -math.pi / 2 or math.pi / 2, 0)
		* CFrame.Angles(rig.bodyRot, 0, 0)

	rig.torso.CFrame = root

	local headCF = root * CFrame.new(0, 1.5, 0) * CFrame.Angles(rig.headRot, 0, 0)
	rig.head.CFrame = headCF
	for _, h in ipairs(rig.hair) do
		h.part.CFrame = headCF * h.off
	end

	local function limb(offset, rot)
		return root * CFrame.new(offset) * CFrame.Angles(rot, 0, 0) * CFrame.new(0, -1, 0)
	end
	rig.armL.CFrame = limb(Vector3.new(-1.5,  1, 0), rig.armLRot)
	rig.armR.CFrame = limb(Vector3.new( 1.5,  1, 0), rig.armRRot)
	rig.legL.CFrame = limb(Vector3.new(-0.5, -1, 0), rig.legLRot)
	rig.legR.CFrame = limb(Vector3.new( 0.5, -1, 0), rig.legRRot)

	if rig.hammerVisible then
		local hand = rig.armR.CFrame * CFrame.new(0, -1, 0)
		local hcf = hand * CFrame.Angles(rig.hammerRot, 0, 0) * CFrame.new(0, -1.4, 0)
		rig.hamHandle.CFrame = hcf
		rig.hamHead.CFrame   = hcf * CFrame.new(0, -1.9, 0)
		rig.hamBand.CFrame   = hcf * CFrame.new(0, -1.9, 0)
	end
end

local bacon     = buildBacon("Bacon", C.shirt, C.legs)
local neighbour = buildBacon("NeighbourBacon", C.nbShirt, C.nbLegs)
setRigVisible(bacon, false)
setHammerVisible(bacon, false)
setHammerVisible(neighbour, false)

