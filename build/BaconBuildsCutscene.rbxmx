local signModel = Instance.new("Model"); signModel.Name = "Sign"; signModel.Parent = SET
newPart(signModel, Vector3.new(0.5, 6, 0.5), at(SIGN_X, GY + 3, SIGN_Z), C.wood, Enum.Material.Wood)
local signBoard = newPart(signModel, Vector3.new(7, 3.4, 0.4), at(SIGN_X, GY + 6.6, SIGN_Z), C.white, Enum.Material.Wood)
