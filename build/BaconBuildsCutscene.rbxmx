----------------------------------------------------------------------
-- MATH
----------------------------------------------------------------------
local function lerp(a, b, t) return a + (b - a) * t end
local function inv(t, a, b) return math.clamp((t - a) / (b - a), 0, 1) end

local function eIO(t)
	if t < 0.5 then return 4 * t * t * t end
	return 1 - ((-2 * t + 2) ^ 3) / 2
end
local function eOut(t) return 1 - (1 - t) ^ 3 end
local function eIn(t)  return t * t * t end
local function eBack(t)
	local c = 2.0
	return 1 + (c + 1) * (t - 1) ^ 3 + c * (t - 1) ^ 2
end
local function eElastic(t)
	if t <= 0 then return 0 end
	if t >= 1 then return 1 end
	return 2 ^ (-9 * t) * math.sin((t * 10 - 0.75) * (2 * math.pi / 3)) + 1
end

local function track(keys, t, ease)
	ease = ease or eIO
	if t <= keys[1][1] then return keys[1][2] end
	for i = 1, #keys - 1 do
		local a, b = keys[i], keys[i + 1]
		if t <= b[1] then
			return lerp(a[2], b[2], ease(inv(t, a[1], b[1])))
		end
	end
	return keys[#keys][2]
end

----------------------------------------------------------------------
-- STAGE LAYOUT
--   +Z faces the camera. Bacon walks along X in a lane in front of
--   everything, so he never ends up inside a wall.
----------------------------------------------------------------------
local ORIGIN   = CFrame.new(0, CONFIG.BuildHeight, 0)
local GY       = 0        -- ground level, local to ORIGIN
local LANE     = 14       -- Bacon's walking lane on Z
local HX       = 24       -- house centre on X
local NX       = 72       -- mansion centre on X
local SIGN_X   = 14
local SIGN_Z   = 14

local function at(x, y, z) return ORIGIN * CFrame.new(x, y, z) end

local ROOT = Instance.new("Folder")
ROOT.Name = "BaconBuildsCutscene"
ROOT.Parent = workspace

local SET     = Instance.new("Folder"); SET.Name     = "Set";     SET.Parent     = ROOT
local HOUSE   = Instance.new("Folder"); HOUSE.Name   = "House";   HOUSE.Parent   = ROOT
local MANSION = Instance.new("Folder"); MANSION.Name = "Mansion"; MANSION.Parent = ROOT
local FX      = Instance.new("Folder"); FX.Name      = "FX";      FX.Parent      = ROOT

----------------------------------------------------------------------
-- PART HELPERS
----------------------------------------------------------------------
local function newPart(parent, size, cf, color, material, shape)
	local p = Instance.new("Part")
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape then p.Shape = shape end
	p.Parent = parent
	return p
end

local function wedge(parent, size, cf, color, material)
	local p = Instance.new("WedgePart")
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Parent = parent
	return p
end

----------------------------------------------------------------------
-- VFX
----------------------------------------------------------------------
local TEX_SMOKE   = "rbxasset://textures/particles/smoke_main.dds"
local TEX_SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"

local function emitterHost(cf)
	local p = newPart(FX, Vector3.new(0.2, 0.2, 0.2), cf, C.white)
	p.Transparency = 1
	local a = Instance.new("Attachment")
	a.Parent = p
	return p, a
end

local function burstDust(cf, amount, power)
	local part, a = emitterHost(cf)
	local e = Instance.new("ParticleEmitter")
	e.Texture = TEX_SMOKE
	e.Color = ColorSequence.new(Color3.fromRGB(232, 220, 196))
	e.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.25),
		NumberSequenceKeypoint.new(1, 1),
	})
	e.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1.5),
		NumberSequenceKeypoint.new(1, 6),
	})
	e.Lifetime = NumberRange.new(0.45, 0.9)
	e.Speed = NumberRange.new(power * 0.6, power)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-90, 90)
	e.Acceleration = Vector3.new(0, -14, 0)
	e.Enabled = false
	e.Parent = a
	e:Emit(amount)
	Debris:AddItem(part, 3)
end

local function burstConfetti(cf, amount, power)
	local part, a = emitterHost(cf)
	local e = Instance.new("ParticleEmitter")
	e.Texture = TEX_SPARKLE
	e.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0.00, C.gold),
		ColorSequenceKeypoint.new(0.25, C.tomato),
		ColorSequenceKeypoint.new(0.50, Color3.fromRGB(91, 216, 138)),
		ColorSequenceKeypoint.new(0.75, C.water),
		ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 143, 208)),
	})
	e.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.78, 0),
		NumberSequenceKeypoint.new(1, 1),
	})
	e.Size = NumberSequence.new(0.9)
	e.Lifetime = NumberRange.new(1.4, 2.6)
	e.Speed = NumberRange.new(power * 0.5, power)
	e.SpreadAngle = Vector2.new(70, 70)
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-260, 260)
	e.Acceleration = Vector3.new(0, -32, 0)
	e.LightEmission = 0.4
	e.Enabled = false
	e.Parent = a
	e:Emit(amount)
	Debris:AddItem(part, 5)
end

local function burstSparkle(cf, amount, spread)
	local part, a = emitterHost(cf)
	local e = Instance.new("ParticleEmitter")
	e.Texture = TEX_SPARKLE
	e.Color = ColorSequence.new(Color3.fromRGB(255, 244, 194))
	e.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(1, 1),
	})
	e.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1.6),
		NumberSequenceKeypoint.new(1, 0),
	})
	e.Lifetime = NumberRange.new(0.5, 1.1)
	e.Speed = NumberRange.new(spread * 0.4, spread)
	e.SpreadAngle = Vector2.new(180, 180)
	e.LightEmission = 1
	e.Enabled = false
	e.Parent = a
	e:Emit(amount)
	Debris:AddItem(part, 3)
end

local function makeSmokeStack(cf)
	local _, a = emitterHost(cf)
	local e = Instance.new("ParticleEmitter")
	e.Texture = TEX_SMOKE
	e.Color = ColorSequence.new(Color3.fromRGB(242, 237, 227))
	e.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.35),
		NumberSequenceKeypoint.new(1, 1),
	})
	e.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1.2),
		NumberSequenceKeypoint.new(1, 4.5),
	})
	e.Lifetime = NumberRange.new(2.0, 3.0)
	e.Rate = 7
	e.Speed = NumberRange.new(3, 5)
	e.SpreadAngle = Vector2.new(14, 14)
	e.Acceleration = Vector3.new(2.5, 2, 0)
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-30, 30)
	e.Enabled = false
	e.Parent = a
	return e
end

----------------------------------------------------------------------
-- SOUND HELPERS
----------------------------------------------------------------------
local function play(id, vol, pitch)
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = (vol or 0.6) * CONFIG.MasterVolume
	s.PlaybackSpeed = pitch or 1
	s.Parent = SoundService
	s:Play()
	Debris:AddItem(s, 8)
	return s
end

local music
local function startMusic()
	if CONFIG.MusicId == "" then return end
	music = Instance.new("Sound")
	music.SoundId = CONFIG.MusicId
	music.Volume = CONFIG.MusicVolume * CONFIG.MasterVolume
	music.Looped = true
	music.Parent = SoundService
	music:Play()
end

----------------------------------------------------------------------
-- GROUND AND SCENERY
----------------------------------------------------------------------
newPart(SET, Vector3.new(420, 4, 220), at(40, GY - 2, 0), C.grass, Enum.Material.Grass)

do
	local rnd = Random.new(7)
	for i = 1, 30 do
		local x = -70 + i * 7 + rnd:NextNumber(-2, 2)
		local z = (i % 2 == 0) and rnd:NextNumber(-80, -34) or rnd:NextNumber(42, 86)
		local s = rnd:NextNumber(0.8, 1.5)
		newPart(SET, Vector3.new(1.2 * s, 5 * s, 1.2 * s), at(x, GY + 2.5 * s, z), C.wood)
		for _ = 1, 3 do
			newPart(SET, Vector3.new(5 * s, 5 * s, 5 * s),
				at(x + rnd:NextNumber(-2, 2), GY + 5 * s + rnd:NextNumber(0, 2.2), z + rnd:NextNumber(-2, 2)),
				C.leaf, Enum.Material.Grass, Enum.PartType.Ball)
		end
	end
	for i = 1, 11 do
		newPart(SET, Vector3.new(64, 64, 64), at(-90 + i * 24, GY - 28, -130), C.hill, Enum.Material.Grass, Enum.PartType.Ball)
	end
end

