# Versand des Kontaktformulars per SMTP (serverseitig, niemals im Frontend).
# Ohne diese Angaben meldet das Formular ehrlich, dass der Online-Versand
# nicht eingerichtet ist, und verweist auf Telefon und E-Mail.
SMTP_HOST=
SMTP_PORT=587
# true für Port 465 (TLS), false für 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Absender muss zum SMTP-Konto passen, z. B. website@issa-immobilien.de
CONTACT_FROM=
# Empfänger der Anfragen
CONTACT_TO=info@issa-immobilien.de

# Laufzeit des Node-Servers
HOST=0.0.0.0
PORT=4321
