---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Study from '../components/Study.astro';
import ContactBand from '../components/ContactBand.astro';
import { company } from '../data/site';

const principles = [
  {
    title: 'Persönliche Beratung',
    text: 'Sie sprechen direkt mit dem Inhaber. Fragen werden dort beantwortet, wo auch die Entscheidungen getroffen werden.',
  },
  {
    title: 'Fundierte Standortbetrachtung',
    text: 'Mikro- und Makrolage gehören zur Einschätzung jeder Immobilie – ebenso wie ihre Nutzungsmöglichkeiten.',
  },
  {
    title: 'Professionelle Vermarktung',
    text: 'Ein durchdachtes Konzept, ein aussagekräftiges Exposé und eine gezielte Ansprache der passenden Interessenten.',
  },
  {
    title: 'Strukturierte Begleitung',
    text: 'Klare Schritte von der Analyse über Besichtigungen bis zu den Vertragsverhandlungen und der Übergabe.',
  },
  {
    title: 'Diskretion',
    text: 'Immobilienangelegenheiten sind oft persönlich. Wir gehen mit Ihren Informationen entsprechend sorgfältig um.',
  },
  {
    title: 'Erfahrung & Blick fürs Wesentliche',
    text: 'Wir konzentrieren uns auf das, was eine Immobilie tatsächlich ausmacht, und darauf, was Ihr Vorhaben voranbringt.',
  },
];
---

<Base
  title="Über uns"
  description="Issa Immobilien mit Sitz in Lippstadt: Inhaber Sami Issa begleitet Eigentümer, Suchende und Unternehmen persönlich bei Vermarktung, Vermietung und gewerblichen Vorhaben."
>
  <PageHero
    eyebrow="Über uns"
    title="Persönlich, strukturiert und"
    emphasis="diskret."
    lead="Issa Immobilien hat seinen Sitz in Lippstadt. Inhaber Sami Issa begleitet Eigentümer, Suchende und Unternehmen persönlich – von der ersten Einschätzung bis zur Übergabe."
  />

  <section class="owner section" aria-labelledby="owner-title">
    <div class="container grid">
      <div class="owner__image">
        <Study name="interior" ratio="4 / 5" sizes="(min-width: 60em) 40vw, 100vw" position="45% 50%" />
      </div>
      <div class="owner__text">
        <p class="eyebrow" data-reveal><span class="index">01</span> Inhaber</p>
        <h2 id="owner-title" class="h2 owner__name" data-reveal>{company.owner}</h2>
        <p class="owner__role" data-reveal>Inhaber von {company.name}</p>
        <div class="prose owner__prose" data-reveal>
          <p>
            Bei Issa Immobilien haben Sie einen festen Ansprechpartner. Sami Issa betreut Ihr Anliegen selbst – vom
            ersten Gespräch über die Analyse von Immobilie und Standort bis zur Begleitung der Verhandlungen.
          </p>
          <p>
            Jede Immobilie bringt eigene Voraussetzungen und Ziele mit sich. Deshalb beginnt die Arbeit mit dem genauen
            Verständnis Ihres Anliegens und einer Beratung, die sich an Ihrer Immobilie orientiert.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="principles section surface-deep" aria-labelledby="principles-title">
    <div class="container grid">
      <div class="principles__head">
        <p class="eyebrow" data-reveal><span class="index">02</span> Haltung</p>
        <h2 id="principles-title" class="h2 principles__title" data-reveal>
          Wofür <em>Issa Immobilien</em> steht.
        </h2>
      </div>
      <ol class="principles__list" role="list">
        {
          principles.map((p, i) => (
            <li data-reveal style={`--reveal-delay:${(i % 2) * 90}`}>
              <span class="principles__no">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="h4">{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="facts section" aria-labelledby="facts-title">
    <div class="container grid">
      <div class="facts__head">
        <p class="eyebrow" data-reveal><span class="index">03</span> Rahmen</p>
        <h2 id="facts-title" class="h3 facts__title" data-reveal>Transparente Grundlagen</h2>
      </div>
      <dl class="facts__list" data-reveal>
        <div>
          <dt>Unternehmen</dt>
          <dd>{company.name}, Inhaber {company.owner}</dd>
        </div>
        <div>
          <dt>Sitz</dt>
          <dd>{company.street}, {company.zip} {company.city}</dd>
        </div>
        <div>
          <dt>Erlaubnis</dt>
          <dd>{company.license.basis}, erteilt durch den {company.license.authority}</dd>
        </div>
        <div>
          <dt>Zuständige Kammer</dt>
          <dd>{company.chamber}</dd>
        </div>
      </dl>
    </div>
  </section>

  <ContactBand />
</Base>

<style>
  .owner__name {
    margin-top: 1.25rem;
  }

  .owner__role {
    margin-top: 0.5rem;
    color: var(--muted);
  }

  .owner__prose {
    margin-top: var(--space-4);
    color: var(--ink-soft);
  }

  .principles__title {
    margin-top: 1.25rem;
    max-width: 12ch;
  }

  .principles__list {
    display: grid;
    gap: 0 var(--gutter);
    border-top: 1px solid var(--line-strong);
  }

  .principles__list li {
    display: grid;
    gap: 0.6rem;
    padding-block: 1.75rem 2rem;
    border-bottom: 1px solid var(--line);
  }

  .principles__list p {
    color: var(--ink-soft);
    max-width: 30rem;
  }

  .principles__no {
    font-family: var(--serif);
    font-style: italic;
    color: var(--accent);
  }

  .facts__list > div {
    display: grid;
    gap: 0.25rem;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--line);
  }

  .facts__list > div:first-child {
    border-top: 1px solid var(--line-strong);
  }

  .facts__list dt {
    font-size: var(--fs-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (min-width: 40em) {
    .principles__list {
      grid-template-columns: 1fr 1fr;
    }

    .facts__list > div {
      grid-template-columns: 12rem 1fr;
      gap: 1.5rem;
    }
  }

  @media (min-width: 60em) {
    .owner__image {
      grid-column: 1 / span 5;
    }

    .owner__text {
      grid-column: 7 / span 6;
      align-self: center;
    }

    .principles__head {
      grid-column: 1 / span 4;
    }

    .principles__list {
      grid-column: 5 / span 8;
    }

    .facts__head {
      grid-column: 1 / span 4;
    }

    .facts__list {
      grid-column: 5 / span 8;
    }
  }
</style>
