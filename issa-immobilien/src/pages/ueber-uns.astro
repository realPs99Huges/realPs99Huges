---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ImageSlot from '../components/ImageSlot.astro';
import ContactBand from '../components/ContactBand.astro';
import { company } from '../data/site';
import { imageSlots } from '../data/images';

const principles = [
  {
    title: 'Fokus auf Handelsimmobilien',
    text: 'Einzelhandelsimmobilien und Handelsstandorte stehen im Mittelpunkt – nicht die Vermittlung privater Wohnimmobilien.',
  },
  {
    title: 'Standortbetrachtung',
    text: 'Mikro- und Makrolage, Flächen und Nutzungsmöglichkeiten gehören zur Einordnung jeder Handelsimmobilie.',
  },
  {
    title: 'Strukturierte Vermarktung',
    text: 'Exposé, gezielte Ansprache geeigneter Interessenten, Besichtigungen und Verhandlungen folgen einem klaren Ablauf.',
  },
  {
    title: 'Persönlicher Ansprechpartner',
    text: 'Sie sprechen direkt mit dem Inhaber – vom ersten Gespräch bis zum Abschluss.',
  },
  {
    title: 'Diskretion',
    text: 'Vermarktung und Standortsuche sind oft vertraulich. Informationen werden entsprechend sorgfältig behandelt.',
  },
  {
    title: 'Deutschlandweit tätig',
    text: 'Der Unternehmenssitz ist Lippstadt, das Tätigkeitsgebiet umfasst ganz Deutschland.',
  },
];
const hasPortrait = Boolean(imageSlots.ueberUns.src);
---

<Base
  title="Über Issa Immobilien"
  description="Issa Immobilien, Inhaber Sami Issa: Spezialist für Einzelhandelsimmobilien und Handelsstandorte mit Sitz in Lippstadt, deutschlandweit tätig."
>
  <PageHero
    eyebrow="Über Issa Immobilien"
    title="Spezialist für Einzelhandelsimmobilien und"
    emphasis="Handelsstandorte."
    lead="Issa Immobilien begleitet die Vermarktung und Vermittlung gewerblicher Einzelhandelsimmobilien – von Fachmarktzentren und großflächigen Handelsflächen bis zu Standorten für Filialunternehmen. Der Sitz ist Lippstadt, das Tätigkeitsgebiet ganz Deutschland."
  />

  <section class="owner section" aria-labelledby="owner-title">
    <div class="container grid">
      {
        hasPortrait && (
          <div class="owner__image">
            <ImageSlot name="ueberUns" ratio="4 / 5" sizes="(min-width: 60em) 36vw, 100vw" />
          </div>
        )
      }
      <div class:list={['owner__text', !hasPortrait && 'owner__text--wide']}>
        <p class="eyebrow" data-reveal>Inhaber</p>
        <h2 id="owner-title" class="h2 owner__name" data-reveal>{company.owner}</h2>
        <p class="owner__role" data-reveal>Inhaber von {company.name}</p>
        <div class="prose owner__prose" data-reveal>
          <p>
            Bei Issa Immobilien haben Sie einen festen Ansprechpartner. Sami Issa betreut Ihr Vorhaben selbst – von der
            Einordnung der Immobilie und des Standorts über die Vermarktung bis zur Begleitung der Verhandlungen.
          </p>
          <p>
            Handelsstandorte folgen eigenen Anforderungen. Deshalb beginnt die Zusammenarbeit mit einem genauen
            Verständnis Ihrer Immobilie, Ihrer Fläche oder Ihres Expansionsvorhabens.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="principles section surface" aria-labelledby="principles-title">
    <div class="container grid">
      <div class="principles__head">
        <p class="eyebrow" data-reveal>Arbeitsweise</p>
        <h2 id="principles-title" class="h2 principles__title" data-reveal>
          Wofür <span class="accent">Issa Immobilien</span> steht.
        </h2>
      </div>
      <ul class="principles__list" role="list">
        {
          principles.map((p, i) => (
            <li data-reveal style={`--reveal-delay:${(i % 2) * 90}`}>
              <h3 class="h4">{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="facts section" aria-labelledby="facts-title">
    <div class="container grid">
      <div class="facts__head">
        <p class="eyebrow" data-reveal>Unternehmen</p>
        <h2 id="facts-title" class="h3 facts__title" data-reveal>Angaben im Überblick</h2>
      </div>
      <dl class="facts__list" data-reveal>
        <div>
          <dt>Unternehmen</dt>
          <dd>{company.name}, Inhaber {company.owner}</dd>
        </div>
        <div>
          <dt>Schwerpunkt</dt>
          <dd>Einzelhandelsimmobilien und Handelsstandorte</dd>
        </div>
        <div>
          <dt>Tätigkeitsgebiet</dt>
          <dd>Deutschlandweit</dd>
        </div>
        <div>
          <dt>Sitz</dt>
          <dd>{company.street}, {company.zip} {company.city}</dd>
        </div>
        <div>
          <dt>Erlaubnis</dt>
          <dd>{company.license.basis}, erteilt durch den {company.license.authority}</dd>
        </div>
        <div>
          <dt>Zuständige Kammer</dt>
          <dd>{company.chamber}</dd>
        </div>
      </dl>
    </div>
  </section>

  <ContactBand />
</Base>

<style>
  .owner__name {
    margin-top: 1.25rem;
  }

  .owner__role {
    margin-top: 0.5rem;
    font-weight: 560;
    color: var(--green-strong);
  }

  .owner__prose {
    margin-top: var(--space-4);
  }

  .principles__title {
    margin-top: 1.25rem;
    max-width: 12ch;
  }

  .principles__list {
    display: grid;
    gap: 0 var(--gutter);
    border-top: 3px solid var(--anthracite);
  }

  .principles__list li {
    position: relative;
    display: grid;
    gap: 0.5rem;
    padding: 1.6rem 0 1.8rem 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .principles__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 2.05rem;
    width: 0.5rem;
    height: 0.5rem;
    background: var(--green);
  }

  .principles__list p {
    color: var(--text-2);
    max-width: 30rem;
  }

  .facts__list > div {
    display: grid;
    gap: 0.25rem;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--line);
  }

  .facts__list > div:first-child {
    border-top: 3px solid var(--green);
  }

  .facts__list dt {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .facts__list dd {
    font-weight: 520;
  }

  @media (min-width: 40em) {
    .principles__list {
      grid-template-columns: 1fr 1fr;
    }

    .facts__list > div {
      grid-template-columns: 12rem 1fr;
      gap: 1.5rem;
    }
  }

  @media (min-width: 60em) {
    .owner__image {
      grid-column: 1 / span 5;
    }

    .owner__text {
      grid-column: 7 / span 6;
      align-self: center;
    }

    .owner__text--wide {
      grid-column: 1 / span 8;
    }

    .principles__head {
      grid-column: 1 / span 4;
    }

    .principles__list {
      grid-column: 5 / span 8;
    }

    .facts__head {
      grid-column: 1 / span 4;
    }

    .facts__list {
      grid-column: 5 / span 8;
    }
  }
</style>
