---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ImageSlot from '../components/ImageSlot.astro';
import ContactBand from '../components/ContactBand.astro';
import { company } from '../data/site';
import { imageSlots } from '../data/images';

const hasPortrait = Boolean(imageSlots.ueberUns.src);
---

<Base
  title="Über Issa Immobilien"
  description="Issa Immobilien, Inhaber Sami Issa: Der Immobilien-Profi für Einzelhandels- und Gewerbeimmobilien. Sitz in Lippstadt, tätig in ganz Deutschland."
>
  <PageHero
    eyebrow="Über Issa Immobilien"
    title="Der Immobilien-Profi für Handel und Gewerbe."
    lead="Issa Immobilien ist auf Einzelhandelsimmobilien und Handelsstandorte spezialisiert und in ganz Deutschland tätig. Der Sitz ist Lippstadt."
  />

  <section class="owner section" aria-labelledby="owner-title">
    <div class="container grid">
      {
        hasPortrait && (
          <div class="owner__image">
            <ImageSlot name="ueberUns" ratio="4 / 5" sizes="(min-width: 60em) 36vw, 100vw" />
          </div>
        )
      }
      <div class:list={['owner__text', !hasPortrait && 'owner__text--wide']}>
        <h2 id="owner-title" class="h2" data-reveal>{company.owner}</h2>
        <p class="owner__role" data-reveal>Inhaber</p>
        <p class="lead owner__lead" data-reveal>
          Bei Issa Immobilien haben Sie einen Ansprechpartner: Sami Issa betreut jedes Vorhaben selbst – vom ersten
          Gespräch bis zum Abschluss.
        </p>
      </div>
    </div>
  </section>

  <section class="facts section" aria-labelledby="facts-title">
    <div class="container grid">
      <h2 id="facts-title" class="h3 facts__title" data-reveal>Auf einen Blick</h2>
      <dl class="facts__list" data-reveal>
        <div>
          <dt>Unternehmen</dt>
          <dd>{company.name}, Inhaber {company.owner}</dd>
        </div>
        <div>
          <dt>Schwerpunkt</dt>
          <dd>Einzelhandels- und Gewerbeimmobilien</dd>
        </div>
        <div>
          <dt>Tätigkeitsgebiet</dt>
          <dd>Deutschlandweit</dd>
        </div>
        <div>
          <dt>Sitz</dt>
          <dd>{company.street}, {company.zip} {company.city}</dd>
        </div>
        <div>
          <dt>Erlaubnis</dt>
          <dd>{company.license.basis}, erteilt durch den {company.license.authority}</dd>
        </div>
        <div>
          <dt>Kammer</dt>
          <dd>{company.chamber}</dd>
        </div>
      </dl>
    </div>
  </section>

  <ContactBand />
</Base>

<style>
  .owner__role {
    margin-top: 0.5rem;
    font-weight: 650;
    color: var(--green);
  }

  .owner__lead {
    margin-top: 1.5rem;
    max-width: 40rem;
    color: var(--text);
  }

  .facts {
    padding-top: 0;
  }

  .facts__list > div {
    display: grid;
    gap: 0.25rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .facts__list > div:first-child {
    border-top: 2px solid var(--anthracite);
  }

  .facts__list dt {
    font-size: var(--fs-xs);
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .facts__list dd {
    font-weight: 560;
  }

  @media (min-width: 40em) {
    .facts__list > div {
      grid-template-columns: 12rem 1fr;
      gap: 1.5rem;
    }
  }

  @media (min-width: 60em) {
    .owner__image {
      grid-column: 1 / span 5;
    }

    .owner__text {
      grid-column: 7 / span 6;
      align-self: center;
    }

    .owner__text--wide {
      grid-column: 1 / span 8;
    }

    .facts__title {
      grid-column: 1 / span 4;
    }

    .facts__list {
      grid-column: 5 / span 8;
    }
  }
</style>
