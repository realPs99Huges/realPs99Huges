---
import raw from '../../content/objekte.json';
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import PhotoStrip from '../../components/PhotoStrip.astro';
import ContactBand from '../../components/ContactBand.astro';
import Arrow from '../../components/Arrow.astro';
import { examples } from '../../data/site';

// Sammlung nur abfragen, wenn Einträge gepflegt sind (vermeidet Build-Warnungen bei leerer Liste).
const objekte = raw.length ? (await getCollection('objekte')).filter((o) => o.data.veroeffentlicht) : [];
---

<Base
  title="Handelsimmobilien"
  description="Handelsimmobilien mit Issa Immobilien: Lebensmittelmärkte, Fachmärkte, Fachmarktzentren, Shopping-Center, Filialstandorte, Gewerbeflächen und vieles mehr – deutschlandweit."
>
  <PageHero
    eyebrow="Handelsimmobilien"
    title="Immobilien für Handel und Gewerbe."
    lead="Wir vermarkten und vermitteln Einzelhandels- und Gewerbeimmobilien in ganz Deutschland. Ob aktuell passende Objekte verfügbar sind, besprechen wir gern direkt mit Ihnen."
  />

  {
    objekte.length > 0 && (
      <section class="section" aria-labelledby="angebote-title">
        <div class="container">
          <h2 id="angebote-title" class="h2 listings__title">Aktuelle Angebote</h2>
          <ul class="listings" role="list">
            {objekte.map((o) => (
              <li data-reveal>
                <a href={`/handelsimmobilien/${o.id}/`} class="listing">
                  <div class="listing__image">
                    <Picture
                      src={o.data.bilder[0].src}
                      alt={o.data.bilder[0].alt}
                      formats={['avif', 'webp']}
                      widths={[480, 720, 960]}
                      sizes="(min-width: 60em) 45vw, 100vw"
                    />
                  </div>
                  <p class="listing__meta">
                    {o.data.vermarktung} · {o.data.art} · {o.data.ort}
                  </p>
                  <h3 class="h3">{o.data.titel}</h3>
                  <p class="listing__text">{o.data.kurzbeschreibung}</p>
                  {o.data.preis && <p class="listing__price">{o.data.preis}</p>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section" aria-labelledby="examples-title">
    <div class="container">
      <h2 id="examples-title" class="examples__label" data-reveal>Zum Beispiel</h2>
      <p class="examples__list">
        {examples.map((e, i) => <span data-reveal style={`--reveal-delay:${i * 70}`}>{e}</span>)}
        <span class="examples__more" data-reveal style={`--reveal-delay:${examples.length * 70}`}>und vieles mehr.</span>
      </p>
    </div>
  </section>

  <PhotoStrip names={['hero', 'einzelhandel', 'deutschland']} />

  <section class="paths section" aria-labelledby="paths-title">
    <div class="container">
      <h2 id="paths-title" class="visually-hidden">Ihr Anliegen</h2>
      <div class="paths__grid">
        <div class="path" data-reveal>
          <h3 class="h3">Sie haben eine Immobilie?</h3>
          <p>Wir übernehmen Vermarktung und Vermittlung – zur Miete oder zum Kauf.</p>
          <a href="/kontakt/?anliegen=vermarktung#anfrage" class="btn">Immobilie anbieten <Arrow /></a>
        </div>
        <div class="path" data-reveal style="--reveal-delay:100">
          <h3 class="h3">Sie suchen einen Standort?</h3>
          <p>Wir unterstützen Unternehmen und Filialisten bei der Suche nach passenden Flächen.</p>
          <a href="/kontakt/?anliegen=expansion#anfrage" class="btn btn--outline">Standort anfragen <Arrow /></a>
        </div>
      </div>
    </div>
  </section>

  <ContactBand />
</Base>

<style>
  .listings__title {
    margin-bottom: var(--space-4);
  }

  .listings {
    display: grid;
    gap: var(--space-5) var(--gutter);
  }

  @media (min-width: 48em) {
    .listings {
      grid-template-columns: 1fr 1fr;
    }
  }

  .listing {
    display: grid;
    gap: 0.75rem;
    text-decoration: none;
  }

  .listing__image {
    overflow: hidden;
    border-radius: var(--radius-lg);
    aspect-ratio: 4 / 3;
    margin-bottom: 0.5rem;
    background: var(--surface-2);
  }

  .listing__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s var(--ease-out);
  }

  .listing:hover .listing__image :global(img) {
    transform: scale(1.03);
  }

  .listing__meta {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--green-strong);
  }

  .listing__text {
    color: var(--text-2);
  }

  .listing__price {
    font-weight: 650;
  }

  .examples__label {
    margin-bottom: 1rem;
    font-size: var(--fs-xs);
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .examples__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0;
    font-size: clamp(1.75rem, 1.1rem + 3vw, 4rem);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.02em;
  }

  .examples__list span:not(:last-child):not(:nth-last-child(2))::after {
    content: '/';
    margin-inline: 0.4em;
    color: var(--green);
  }

  .examples__more {
    margin-left: 0.3em;
    font-weight: 700;
    color: var(--green);
  }

  .paths__grid {
    display: grid;
    border-top: 2px solid var(--anthracite);
  }

  .path {
    display: grid;
    gap: 1rem;
    justify-items: start;
    padding-block: 2rem 2.5rem;
    border-bottom: 1px solid var(--line);
  }

  .path p {
    max-width: 30rem;
    color: var(--text-2);
  }

  @media (min-width: 60em) {
    .paths__grid {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--gutter);
    }
  }
</style>
