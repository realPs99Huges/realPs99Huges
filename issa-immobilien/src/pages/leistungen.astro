---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ServiceAreas from '../components/ServiceAreas.astro';
import Process from '../components/Process.astro';
import PhotoStrip from '../components/PhotoStrip.astro';
import ContactBand from '../components/ContactBand.astro';
import { services, examples } from '../data/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Leistungen von Issa Immobilien',
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Service',
      name: s.title,
      description: s.text,
      areaServed: { '@type': 'Country', name: 'Deutschland' },
      provider: { '@id': 'https://www.issa-immobilien.de/#unternehmen' },
    },
  })),
};
---

<Base
  title="Leistungen"
  description="Leistungen von Issa Immobilien: Vermarktung und Vermittlung von Einzelhandels- und Gewerbeimmobilien, Standortanalyse, Exposés, Verhandlungen, Standortsuche und Expansion – deutschlandweit."
  schema={schema}
>
  <PageHero
    eyebrow="Leistungen"
    title="Leistungen."
    lead="Vermarktung und Vermittlung von Einzelhandelsimmobilien und Handelsstandorten in ganz Deutschland – für Eigentümer, Vermieter und Unternehmen, die einen Standort suchen."
  />

  <section class="section">
    <div class="container">
      <ServiceAreas detailed />

      <div class="examples">
        <p class="eyebrow examples__label" data-reveal>Immobilien, zum Beispiel</p>
        <p class="examples__list">
          {examples.map((e, i) => <span data-reveal style={`--reveal-delay:${i * 60}`}>{e}</span>)}
          <span class="examples__more" data-reveal style={`--reveal-delay:${examples.length * 60}`}>und vieles mehr.</span>
        </p>
      </div>
    </div>
  </section>

  <PhotoStrip names={['hero', 'einzelhandel', 'deutschland']} />

  <Process />
  <ContactBand />
</Base>

<style>
  .examples {
    margin-top: var(--space-5);
  }

  .examples__label {
    margin-bottom: 1rem;
  }

  .examples__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0;
    font-size: clamp(1.375rem, 1rem + 1.8vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .examples__list span:not(:last-child):not(:nth-last-child(2))::after {
    content: '/';
    margin-inline: 0.4em;
    color: var(--green);
  }

  .examples__more {
    margin-left: 0.3em;
    font-weight: 700;
    color: var(--green);
  }
</style>
