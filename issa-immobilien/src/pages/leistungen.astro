---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ServiceList from '../components/ServiceList.astro';
import PhotoStrip from '../components/PhotoStrip.astro';
import ContactBand from '../components/ContactBand.astro';
import { services, examples } from '../data/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Leistungen von Issa Immobilien',
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Service',
      name: s.title,
      description: s.text,
      areaServed: { '@type': 'Country', name: 'Deutschland' },
      provider: { '@id': 'https://www.issa-immobilien.de/#unternehmen' },
    },
  })),
};
---

<Base
  title="Leistungen"
  description="Leistungen von Issa Immobilien: Vermarktung und Vermittlung von Einzelhandels- und Gewerbeimmobilien, Standortanalyse, Exposés, Verhandlungen, Standortsuche und Expansion – deutschlandweit."
  schema={schema}
>
  <PageHero
    eyebrow="Leistungen"
    title="Was wir machen."
    lead="Vermarktung und Vermittlung von Einzelhandels- und Gewerbeimmobilien in ganz Deutschland – für Eigentümer, Vermieter und Unternehmen, die einen Standort suchen."
  />

  <section class="section">
    <div class="container">
      <ServiceList />

      <div class="examples" data-reveal>
        <p class="examples__label">Immobilien, zum Beispiel</p>
        <ul class="examples__list" role="list">
          {examples.map((e) => <li>{e}</li>)}
          <li class="examples__more">und vieles mehr</li>
        </ul>
      </div>
    </div>
  </section>

  <PhotoStrip names={['hero', 'einzelhandel', 'deutschland']} />

  <ContactBand />
</Base>

<style>
  .examples {
    display: grid;
    gap: 1rem;
    margin-top: var(--space-5);
  }

  .examples__label {
    font-size: var(--fs-xs);
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .examples__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .examples__list li {
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--line-strong);
    font-weight: 600;
  }

  .examples__list .examples__more {
    border-color: var(--green);
    background: var(--green);
    color: var(--white);
  }
</style>
