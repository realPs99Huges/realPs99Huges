---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Study from '../components/Study.astro';
import Process from '../components/Process.astro';
import ContactBand from '../components/ContactBand.astro';
import Arrow from '../components/Arrow.astro';
import { services } from '../data/site';
import type { StudyKey } from '../data/studies';

const images: Partial<Record<(typeof services)[number]['id'], { name: StudyKey; ratio: string; position?: string }>> = {
  analyse: { name: 'horizon', ratio: '3 / 2', position: '65% 50%' },
  gewerbe: { name: 'urban', ratio: '3 / 2' },
};

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Leistungen von Issa Immobilien',
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Service',
      name: s.title,
      description: s.short,
      provider: { '@id': 'https://www.issa-immobilien.de/#unternehmen' },
    },
  })),
};
---

<Base
  title="Leistungen"
  description="Immobilienvermarktung mit Issa Immobilien in Lippstadt: Standortanalyse, Vermarktungskonzept, individuelle Exposés, Besichtigungen, Vertragsverhandlungen sowie Beratung zu Gewerbeflächen und Projektentwicklung."
  schema={schema}
>
  <PageHero
    eyebrow="Leistungen"
    title="Vermarktung, die mit dem Verstehen"
    emphasis="beginnt."
    lead="Wir begleiten Eigentümer und Unternehmen von der ersten Analyse bis zur Übergabe. Jeder Bereich baut auf dem vorherigen auf – so entsteht ein durchgängiges Konzept statt einzelner Maßnahmen."
  >
    <nav class="toc" aria-label="Leistungsbereiche">
      <ol role="list">
        {
          services.map((s) => (
            <li>
              <a href={`#${s.id}`}>
                <span class="toc__no">{s.no}</span> {s.title}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </PageHero>

  <div class="services-detail">
    {
      services.map((s, i) => {
        const img = images[s.id];
        return (
          <>
            <section class="sd section" id={s.id} aria-labelledby={`${s.id}-title`}>
              <div class="container grid">
                <p class="sd__no" aria-hidden="true" data-reveal>
                  {s.no}
                </p>
                <h2 id={`${s.id}-title`} class="h2 sd__title" data-reveal>
                  {s.title}
                </h2>
                <div class="sd__body">
                  <p class="lead" data-reveal>
                    {s.intro}
                  </p>
                  <h3 class="sd__list-title" data-reveal>
                    Was dazu gehört
                  </h3>
                  <ul class="sd__list" role="list">
                    {s.items.map((item, j) => (
                      <li data-reveal style={`--reveal-delay:${j * 70}`}>
                        {item}
                      </li>
                    ))}
                  </ul>
                </div>
                {img && (
                  <div class:list={['sd__image', i % 2 ? 'sd__image--right' : 'sd__image--left']}>
                    <Study name={img.name} ratio={img.ratio} position={img.position} sizes="(min-width: 60em) 58vw, 100vw" />
                  </div>
                )}
              </div>
            </section>
            {i === 1 && (
              <div class="container sd__band">
                <Study name="residence" ratio="21 / 9" position="50% 38%" sizes="(min-width: 90em) 1440px, 100vw" />
              </div>
            )}
          </>
        );
      })
    }
  </div>

  <section class="note section surface-deep" aria-labelledby="note-title">
    <div class="container grid">
      <h2 id="note-title" class="h3 note__title" data-reveal>Sie sind sich nicht sicher, welche Leistung Sie benötigen?</h2>
      <div class="note__body" data-reveal>
        <p class="prose">
          Das ist der Normalfall. In einem ersten Gespräch klären wir, wo Sie stehen und welche Schritte für Ihre
          Immobilie sinnvoll sind.
        </p>
        <a href="/kontakt/" class="link-arrow">Gespräch vereinbaren <Arrow class="" /></a>
      </div>
    </div>
  </section>

  <Process />
  <ContactBand />
</Base>

<style>
  .toc {
    margin-top: 1.5rem;
  }

  .toc ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .toc a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    min-height: 2.75rem;
    align-items: center;
    padding: 0.5rem 1rem;
    border: 1px solid var(--line-strong);
    font-size: var(--fs-sm);
    text-decoration: none;
    transition:
      background-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }

  .toc a:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .toc__no {
    font-family: var(--serif);
    font-style: italic;
    color: var(--accent);
  }

  .toc a:hover .toc__no {
    color: var(--on-dark-accent);
  }

  @media (min-width: 60em) {
    .toc {
      grid-column: 1 / -1;
    }
  }

  .sd + .sd {
    border-top: 1px solid var(--line);
  }

  .sd__no {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(3rem, 2rem + 4vw, 6rem);
    font-weight: 300;
    line-height: 0.9;
    color: var(--accent);
  }

  .sd__title {
    max-width: 12ch;
  }

  .sd__list-title {
    margin-top: var(--space-4);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .sd__list {
    margin-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .sd__list li {
    position: relative;
    padding: 1rem 0 1rem 2rem;
    border-bottom: 1px solid var(--line);
  }

  .sd__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.75rem;
    width: 1rem;
    height: 1px;
    background: var(--accent);
  }

  .sd__band {
    padding-bottom: var(--space-6);
  }

  .note__body {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  @media (min-width: 60em) {
    .sd__no {
      grid-column: 1 / span 2;
    }

    .sd__title {
      grid-column: 3 / span 4;
      position: sticky;
      top: calc(var(--header-h) + 2rem);
      align-self: start;
    }

    .sd__body {
      grid-column: 8 / span 5;
    }

    .sd__image {
      grid-column: 3 / span 7;
      margin-top: var(--space-4);
    }

    .sd__image--right {
      grid-column: 6 / span 7;
    }

    .note__title {
      grid-column: 1 / span 6;
    }

    .note__body {
      grid-column: 8 / span 5;
    }
  }
</style>
