---
/**
 * Großes Original-Logo mit Aufbau-Animation. Das Logo wird nicht verändert:
 * Drei deckungsgleiche Ebenen derselben Bilddatei zeigen jeweils einen
 * Ausschnitt (Bildmarke, „ISSA“, „IMMOBILIEN“) und werden nacheinander
 * sichtbar. Im Ruhezustand ergeben sie exakt das Original.
 * Ausschnittsgrenzen gemessen an logo-issa-immobilien.png (639 × 185 px):
 * Bildmarke bis x = 187 px (29,26 %), Textzeilen getrennt bei y = 98 px (52,97 %).
 */
import { getImage } from 'astro:assets';
import logo from '../assets/brand/logo-issa-immobilien.png';

const img = await getImage({ src: logo, format: 'png', width: logo.width });
const ratio = `${logo.width} / ${logo.height}`;
---

<span class="logo-reveal" style={`--ratio:${ratio}`} data-intro-logo>
  <img src={img.src} alt="Issa Immobilien" width={logo.width} height={logo.height} class="layer layer--mark" fetchpriority="high" />
  <img src={img.src} alt="" aria-hidden="true" width={logo.width} height={logo.height} class="layer layer--issa" />
  <img src={img.src} alt="" aria-hidden="true" width={logo.width} height={logo.height} class="layer layer--immo" />
</span>

<style>
  .logo-reveal {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: var(--ratio);
  }

  .layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Ruhezustand: die drei Ausschnitte ergeben zusammen das vollständige Logo */
  .layer--mark {
    clip-path: polygon(0 0, 29.26% 0, 29.26% 100%, 0 100%);
  }

  .layer--issa {
    clip-path: inset(0 0 47.03% 29.26%);
  }

  .layer--immo {
    clip-path: inset(52.97% 0 0 29.26%);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* 1. Bildmarke wächst diagonal aus der Ecke unten links – entlang der Linien */
    .layer--mark {
      animation: mark-in 1.4s var(--ease-out) 0.15s both;
    }

    /* 2. „ISSA“ steigt aus einer Maske auf */
    .layer--issa {
      animation: issa-in 1s var(--ease-out) 0.85s both;
    }

    /* 3. „IMMOBILIEN“ wird von links nach rechts freigelegt */
    .layer--immo {
      animation: immo-in 1.1s var(--ease-out) 1.2s both;
    }
  }

  @keyframes mark-in {
    from {
      clip-path: polygon(0 100%, 0 100%, 0 100%, 0 100%);
    }
    to {
      clip-path: polygon(0 0, 29.26% 0, 29.26% 100%, 0 100%);
    }
  }

  @keyframes issa-in {
    from {
      clip-path: inset(47.03% 0 47.03% 29.26%);
      transform: translateY(12%);
    }
    to {
      clip-path: inset(0 0 47.03% 29.26%);
      transform: none;
    }
  }

  @keyframes immo-in {
    from {
      clip-path: inset(52.97% 100% 0 29.26%);
    }
    to {
      clip-path: inset(52.97% 0 0 29.26%);
    }
  }
</style>
