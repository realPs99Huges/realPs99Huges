---
/**
 * Bildfläche mit festem Seitenverhältnis. Zeigt das zugeordnete Bild aus
 * src/data/images.ts – oder eine neutrale Fläche, solange keines vorliegt.
 */
import { Picture } from 'astro:assets';
import { imageSlots, type ImageSlotName } from '../data/images';

interface Props {
  name: ImageSlotName;
  sizes: string;
  ratio?: string;
  class?: string;
  position?: string;
  priority?: boolean;
  reveal?: boolean;
}

const { name, sizes, ratio = '3 / 2', class: className, position = '50% 50%', priority = false, reveal = true } = Astro.props;
const slot = imageSlots[name];
const src = slot.src;
const widths = src ? [360, 480, 600, 800, 1200, 1600, 2400].filter((w) => w <= src.width) : [];
if (src && !widths.includes(src.width)) widths.push(src.width);
---

<div
  class:list={['slot', !src && 'slot--empty', className]}
  style={`--ratio:${ratio}`}
  data-reveal={reveal && src ? 'image' : undefined}
  data-slot={name}
>
  {
    src ? (
      <Picture
        src={src}
        alt={slot.alt}
        formats={['avif', 'webp']}
        widths={widths}
        sizes={sizes}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding={priority ? 'sync' : 'async'}
        quality={82}
        style={`object-position:${position}`}
      />
    ) : (
      <span class="visually-hidden">Bildfläche</span>
    )
  }
</div>

<style>
  .slot {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--ratio);
    max-width: 100%;
    background: var(--surface-2);
  }

  .slot :global(picture),
  .slot :global(img) {
    width: 100%;
    height: 100%;
  }

  .slot :global(img) {
    object-fit: cover;
  }

  /* Neutrale Fläche, bis ein eigenes Bild geliefert wird */
  .slot--empty {
    background:
      repeating-linear-gradient(135deg, transparent 0 22px, rgb(42 42 42 / 0.035) 22px 23px),
      var(--surface);
    border: 1px solid var(--line);
  }
</style>
