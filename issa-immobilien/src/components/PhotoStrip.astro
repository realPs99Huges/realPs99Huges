---
/** Bildreihe mit den gelieferten Fotos – klar, ohne Bildunterschriften. */
import ImageSlot from './ImageSlot.astro';
import type { ImageSlotName } from '../data/images';

interface Props {
  names: ImageSlotName[];
}
const { names } = Astro.props;
---

<div class="strip" style={`--n:${names.length}`}>
  {names.map((n, i) => <ImageSlot name={n} ratio="3 / 4" sizes="33vw" class="strip__item" delay={i * 140} />)}
</div>

<style>
  .strip {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 3px;
  }

  @media (min-width: 48em) {
    .strip {
      gap: 4px;
    }

    .strip :global(.strip__item) {
      aspect-ratio: 3 / 2;
    }
  }
</style>
