---
import Logo from './Logo.astro';
import { company, nav, legalNav, mapsUrl } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer on-dark">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a href="/" aria-label="Issa Immobilien – zur Startseite">
          <Logo variant="negativ" height={58} class="site-footer__logo" />
        </a>
        <p class="site-footer__slogan">{company.slogan}</p>
        <p class="site-footer__claim">{company.positioning}. {company.area} tätig.</p>
      </div>

      <div class="site-footer__cols">
        <section aria-labelledby="footer-contact">
          <h2 id="footer-contact" class="site-footer__title">Kontakt</h2>
          <address>
            {company.owner}<br />
            <a href={mapsUrl} target="_blank" rel="noopener noreferrer">
              {company.street}<br />
              {company.zip} {company.city}<span class="visually-hidden"> (öffnet Google Maps in neuem Tab)</span>
            </a>
          </address>
          <p>
            Telefon: <a href={company.phoneHref}>{company.phone}</a><br />
            E-Mail: <a href={`mailto:${company.email}`}>{company.email}</a>
          </p>
        </section>

        <nav aria-labelledby="footer-nav">
          <h2 id="footer-nav" class="site-footer__title">Seiten</h2>
          <ul role="list">
            {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          </ul>
        </nav>

        <nav aria-labelledby="footer-legal">
          <h2 id="footer-legal" class="site-footer__title">Rechtliches</h2>
          <ul role="list">
            {legalNav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          </ul>
        </nav>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>© {year} {company.name} · Inhaber {company.owner}</p>
      <p>Sitz in {company.city} · {company.area} tätig</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-5) 2rem;
    font-size: var(--fs-sm);
    color: var(--on-dark-2);
  }

  .site-footer a {
    text-decoration: none;
    transition: color 0.25s var(--ease);
  }

  .site-footer a:hover {
    color: var(--white);
    text-decoration: underline;
    text-decoration-color: var(--green);
    text-decoration-thickness: 2px;
  }

  .site-footer__top {
    display: grid;
    gap: 3rem;
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--line-dark);
  }

  .site-footer__brand :global(.site-footer__logo) {
    width: auto;
    height: 52px;
  }

  .site-footer__slogan {
    margin-top: 1.5rem;
    padding-left: 0.85rem;
    border-left: 3px solid var(--green);
    font-size: 1.375rem;
    font-weight: 660;
    font-stretch: 88%;
    line-height: 1.1;
    color: var(--white);
  }

  .site-footer__claim {
    margin-top: 1rem;
    max-width: 22rem;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--on-dark-2);
  }

  .site-footer__cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 2.25rem 2rem;
  }

  .site-footer__title {
    margin-bottom: 0.9rem;
    font-size: var(--fs-xs);
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--white);
  }

  .site-footer address {
    font-style: normal;
    margin-bottom: 0.9rem;
  }

  .site-footer li + li {
    margin-top: 0.4rem;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-top: 1.5rem;
    font-size: var(--fs-xs);
    color: var(--on-dark-muted);
  }

  @media (min-width: 60em) {
    .site-footer__top {
      grid-template-columns: 5fr 7fr;
      gap: var(--gutter);
    }
  }
</style>
