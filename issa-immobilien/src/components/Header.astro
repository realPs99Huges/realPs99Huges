---
import Logo from './Logo.astro';
import Arrow from './Arrow.astro';
import { nav, company } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class:list={['site-header', path === '/' && 'site-header--home']} data-header>
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand" aria-label="Issa Immobilien – zur Startseite">
      <Logo height={46} priority class="site-header__logo" />
    </a>
    <p class="site-header__claim">{company.slogan}</p>

    <nav class="site-nav" aria-label="Hauptnavigation">
      <ul role="list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href="/kontakt/" class="btn site-header__cta">
      Kontakt aufnehmen
      <Arrow />
    </a>

    <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
      <span class="menu-toggle__label" data-menu-label>Menü</span>
      <span class="menu-toggle__icon" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-menu hidden>
    <nav class="container mobile-menu__nav" aria-label="Mobile Navigation">
      <ul role="list">
        {
          nav.map((item, i) => (
            <li style={`--i:${i}`}>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
                <Arrow class="mobile-menu__arrow" />
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mobile-menu__contact">
        <a href={company.phoneHref} class="btn">Anrufen: {company.phone}</a>
        <a href={`mailto:${company.email}`} class="mobile-menu__mail">{company.email}</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    view-transition-name: site-header;
    background: var(--white);
    color: var(--text);
    transition:
      box-shadow 0.4s var(--ease),
      transform 0.5s var(--ease-out);
  }

  .site-header.is-hidden {
    transform: translateY(-100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header.is-hidden {
      transform: none;
    }
  }

  .site-header.is-scrolled {
    box-shadow:
      0 1px 0 var(--line),
      0 8px 24px -16px rgb(42 42 42 / 0.25);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: var(--header-h);
    transition: height 0.4s var(--ease);
  }

  .is-scrolled .site-header__inner {
    height: 4.25rem;
  }

  .site-header__brand,
  .site-header__claim {
    transition:
      opacity 0.5s var(--ease),
      transform 0.6s var(--ease-out);
  }

  .site-header__brand {
    flex: none;
    display: block;
  }

  /* Startseite: kleines Logo erst, wenn das große Logo aus dem Bild ist */
  :global(.js) .site-header--home:not(.is-past-intro) .site-header__brand,
  :global(.js) .site-header--home:not(.is-past-intro) .site-header__claim {
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
  }

  .site-header__brand :global(.site-header__logo) {
    width: auto;
    height: 40px;
    transition: height 0.4s var(--ease);
  }

  .is-scrolled .site-header__brand :global(.site-header__logo) {
    height: 36px;
  }

  @media (min-width: 40em) {
    .site-header__brand :global(.site-header__logo) {
      height: 46px;
    }

    .is-scrolled .site-header__brand :global(.site-header__logo) {
      height: 40px;
    }
  }

  .site-header__claim {
    display: none;
    padding-left: 1.25rem;
    border-left: 1px solid var(--line);
    font-size: 0.9375rem;
    font-weight: 650;
    font-stretch: 90%;
    white-space: nowrap;
    color: var(--slate);
  }

  @media (min-width: 86em) {
    .site-header__claim {
      display: block;
      margin-left: -0.75rem;
    }
  }

  .site-nav {
    display: none;
    margin-left: auto;
  }

  .site-nav ul {
    display: flex;
    gap: clamp(1.25rem, 2vw, 2rem);
  }

  .site-nav a {
    position: relative;
    display: block;
    padding-block: 0.6rem;
    font-size: 0.9375rem;
    font-weight: 560;
    text-decoration: none;
    color: var(--text-2);
    transition: color 0.3s var(--ease);
  }

  .site-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.15rem;
    height: 2px;
    background: var(--green);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.5s var(--ease-out);
  }

  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    color: var(--text);
  }

  .site-nav a:hover::after,
  .site-nav a[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .site-header__cta {
    display: none;
    min-height: 2.75rem;
    padding: 0.6rem 1.1rem;
  }

  @media (min-width: 72em) {
    .site-nav,
    .site-header__cta {
      display: flex;
    }

    .menu-toggle {
      display: none !important;
    }
  }

  /* Mobile Navigation */
  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: auto;
    min-height: 2.75rem;
    padding: 0.5rem 0 0.5rem 0.75rem;
    background: none;
    border: 0;
    font-size: var(--fs-sm);
    font-weight: 620;
    letter-spacing: 0.04em;
    cursor: pointer;
  }

  .menu-toggle__icon {
    position: relative;
    width: 1.375rem;
    height: 0.875rem;
  }

  .menu-toggle__icon span {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    background: currentColor;
    transition:
      transform 0.4s var(--ease-out),
      top 0.4s var(--ease-out),
      opacity 0.2s var(--ease);
  }

  .menu-toggle__icon span:nth-child(1) {
    top: 0;
  }

  .menu-toggle__icon span:nth-child(2) {
    top: calc(50% - 1px);
    background: var(--green);
  }

  .menu-toggle__icon span:nth-child(3) {
    top: calc(100% - 2px);
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__icon span:nth-child(1) {
    top: calc(50% - 1px);
    transform: rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__icon span:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__icon span:nth-child(3) {
    top: calc(50% - 1px);
    transform: rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: var(--header-h) 0 0;
    overflow-y: auto;
    background: var(--white);
    border-top: 1px solid var(--line);
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu__nav {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 100%;
    padding-block: 1rem 2rem;
    gap: 2.5rem;
  }

  .mobile-menu li {
    border-bottom: 1px solid var(--line);
  }

  .mobile-menu li a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.1rem;
    font-size: clamp(1.375rem, 5.5vw, 1.75rem);
    font-weight: 620;
    font-stretch: 88%;
    letter-spacing: -0.015em;
    text-decoration: none;
  }

  .mobile-menu li a[aria-current='page'] {
    color: var(--green-strong);
  }

  .mobile-menu li :global(.mobile-menu__arrow) {
    width: 1.25rem;
    color: var(--green);
  }

  .mobile-menu__contact {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  .mobile-menu__contact .btn {
    width: 100%;
  }

  .mobile-menu__mail {
    font-size: var(--fs-sm);
    color: var(--text-2);
  }

  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu {
      clip-path: inset(0 0 100% 0);
      transition: clip-path 0.6s var(--ease-out);
    }

    .mobile-menu.is-open {
      clip-path: inset(0 0 0 0);
    }

    .mobile-menu.is-open li {
      animation: menu-in 0.6s var(--ease-out) both;
      animation-delay: calc(var(--i) * 45ms + 80ms);
    }

    .mobile-menu__contact {
      opacity: 0;
      transform: translateY(10px);
      transition:
        opacity 0.5s var(--ease-out) 0.3s,
        transform 0.6s var(--ease-out) 0.3s;
    }

    .mobile-menu.is-open .mobile-menu__contact {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  :global(html.menu-open) {
    overflow: hidden;
  }

  :global(html.menu-open) .site-header {
    box-shadow: none;
  }

  :global(html.menu-open) .site-header__inner {
    height: var(--header-h);
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');

  if (header) {
    // Kompakter Header nach den ersten Pixeln Scrollweg – passiv und ohne Layout-Arbeit.
    let ticking = false;
    let lastY = window.scrollY;
    const update = () => {
      const y = window.scrollY;
      header.classList.toggle('is-scrolled', y > 24);
      // Beim Runterscrollen Platz machen, beim Hochscrollen sofort wieder da
      const menuOpen = document.documentElement.classList.contains('menu-open');
      if (!menuOpen && y > 320 && y > lastY + 6) header.classList.add('is-hidden');
      else if (y < lastY - 6 || y <= 320 || menuOpen) header.classList.remove('is-hidden');
      lastY = y;
      ticking = false;
    };
    // Startseite: Header-Logo einblenden, sobald das große Logo verlassen wurde
    const introLogo = document.querySelector('[data-intro-logo]');
    if (introLogo && 'IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => {
        header.classList.toggle('is-past-intro', !entry.isIntersecting);
      }, { rootMargin: '-80px 0px 0px 0px' }).observe(introLogo);
    } else {
      header.classList.add('is-past-intro');
    }
    // Fokus per Tastatur im Header holt ihn immer zurück
    header.addEventListener('focusin', () => header.classList.remove('is-hidden'));
    update();
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
  }

  if (toggle && menu) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let closeTimer = 0;
    const setOpen = (open: boolean, immediate = false) => {
      toggle.setAttribute('aria-expanded', String(open));
      if (label) label.textContent = open ? 'Schließen' : 'Menü';
      document.documentElement.classList.toggle('menu-open', open);
      window.clearTimeout(closeTimer);
      if (open) {
        menu.hidden = false;
        // Erst nach dem Einblenden des Elements animieren
        requestAnimationFrame(() => requestAnimationFrame(() => menu.classList.add('is-open')));
        menu.querySelector<HTMLAnchorElement>('a')?.focus({ preventScroll: true });
      } else {
        menu.classList.remove('is-open');
        const animated = !immediate && !reduceMotion.matches;
        closeTimer = window.setTimeout(() => (menu.hidden = true), animated ? 450 : 0);
      }
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
      // Fokus im geöffneten Menü halten
      if (e.key === 'Tab' && toggle.getAttribute('aria-expanded') === 'true') {
        const focusables = [toggle, ...menu.querySelectorAll<HTMLElement>('a')];
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });

    menu.addEventListener('click', (e) => {
      // Beim Seitenwechsel sofort schließen – der Seitenübergang übernimmt die Bewegung.
      if ((e.target as HTMLElement).closest('a')) setOpen(false, true);
    });

    window.matchMedia('(min-width: 72em)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>
