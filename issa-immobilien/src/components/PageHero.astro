---
interface Props {
  eyebrow: string;
  title: string;
  /** Optionaler zweiter Teil der Überschrift (etwas heller gesetzt) */
  emphasis?: string;
  lead?: string;
}
const { eyebrow, title, emphasis, lead } = Astro.props;
---

<header class="page-hero on-dark">
  <div class="container grid">
    <p class="eyebrow page-hero__eyebrow page-hero__in">{eyebrow}</p>
    <h1 class="page-hero__title page-hero__in" style="--d:120">
      {title}{emphasis && <> <span>{emphasis}</span></>}
    </h1>
    {lead && <p class="page-hero__lead page-hero__in" style="--d:240">{lead}</p>}
    <slot />
  </div>
</header>

<style>
  .page-hero {
    margin-top: var(--header-h);
    padding-block: clamp(3rem, 7vw, 6rem) clamp(2.5rem, 5vw, 4.5rem);
    border-bottom: 6px solid var(--green);
  }

  .page-hero .grid {
    row-gap: 1.5rem;
  }

  .page-hero__title {
    max-width: 16ch;
    font-size: clamp(2.25rem, 1.3rem + 4vw, 5rem);
    font-weight: 720;
    font-stretch: 80%;
    line-height: 1;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .page-hero__title span {
    color: var(--on-dark-muted);
  }

  .page-hero__lead {
    max-width: 36rem;
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--on-dark-2);
  }

  @media (min-width: 60em) {
    .page-hero__eyebrow {
      grid-column: 1 / -1;
    }

    .page-hero__title {
      grid-column: 1 / span 7;
    }

    .page-hero__lead {
      grid-column: 8 / span 5;
      align-self: end;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .page-hero__in {
      animation: page-hero-in 0.9s var(--ease-out) both;
      animation-delay: calc(var(--d, 0) * 1ms + 60ms);
    }
  }

  @keyframes page-hero-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
</style>
