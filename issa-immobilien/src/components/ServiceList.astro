---
import { services } from '../data/site';
---

<ol class="services" role="list">
  {
    services.map((s, i) => (
      <li id={s.id} class="services__item" data-reveal style={`--reveal-delay:${(i % 2) * 60}`}>
        <span class="services__no" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <h3 class="services__title">{s.title}</h3>
        <p class="services__text">{s.text}</p>
      </li>
    ))
  }
</ol>

<style>
  .services {
    display: grid;
    border-top: 2px solid var(--anthracite);
  }

  .services__item {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.35rem 1rem;
    padding-block: 1.5rem 1.6rem;
    border-bottom: 1px solid var(--line);
  }

  .services__no {
    grid-row: span 2;
    padding-top: 0.3rem;
    font-size: var(--fs-sm);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--green);
  }

  .services__title {
    font-size: var(--fs-h4);
    font-weight: 680;
    font-stretch: 88%;
    line-height: 1.25;
  }

  .services__text {
    color: var(--text-2);
    max-width: 32rem;
  }

  @media (min-width: 48em) {
    .services {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--gutter);
    }
  }
</style>
