---
/**
 * Architekturzeichnung mit redaktioneller Bildunterschrift.
 * Die Zeichnungen zeigen keine realen Objekte und werden immer als solche
 * gekennzeichnet (siehe docs/BILDER.md).
 */
import { Picture } from 'astro:assets';
import { studies, type StudyKey } from '../data/studies';

interface Props {
  name: StudyKey;
  sizes: string;
  class?: string;
  /** Bildausschnitt, z. B. "70% 50%" */
  position?: string;
  /** Seitenverhältnis des Rahmens, z. B. "4 / 5" */
  ratio?: string;
  caption?: boolean;
  priority?: boolean;
  reveal?: boolean;
}

const {
  name,
  sizes,
  class: className,
  position = '50% 50%',
  ratio,
  caption = true,
  priority = false,
  reveal = true,
} = Astro.props;
const study = studies[name];
---

<figure class:list={['study', className]} style={ratio ? `--ratio:${ratio}` : undefined}>
  <div class="study__frame" data-reveal={reveal ? 'image' : undefined}>
    <Picture
      src={study.src}
      alt={study.alt}
      formats={['avif', 'webp']}
      widths={[480, 720, 960, 1280, 1600, study.src.width].filter((w, i, a) => w <= study.src.width && a.indexOf(w) === i)}
      sizes={sizes}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding={priority ? 'sync' : 'async'}
      style={`object-position:${position}`}
      quality={78}
    />
  </div>
  {
    caption && (
      <figcaption class="study__caption">
        <span class="study__no">Abb. {study.no}</span>
        <span>{study.caption} · Zeichnung</span>
      </figcaption>
    )
  }
</figure>

<style>
  .study {
    position: relative;
  }

  .study__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--ratio, auto);
    background: var(--stone);
    height: 100%;
  }

  .study__frame :global(picture),
  .study__frame :global(img) {
    width: 100%;
    height: 100%;
  }

  .study__frame :global(img) {
    object-fit: cover;
  }

  .study__caption {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.75rem;
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .study__no {
    flex: none;
    font-family: var(--serif);
    font-style: italic;
    color: var(--accent);
    letter-spacing: 0;
  }

  :global(.on-dark) .study__caption {
    color: var(--on-dark-muted);
  }

  :global(.on-dark) .study__no {
    color: var(--on-dark-accent);
  }
</style>
