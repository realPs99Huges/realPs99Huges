---
import Arrow from './Arrow.astro';
import { company } from '../data/site';

interface Props {
  /** Formular-Link ausblenden, z. B. auf der Kontaktseite */
  showFormLink?: boolean;
}
const { showFormLink = true } = Astro.props;
---

<section class="contact section" aria-labelledby="kontakt-band-title">
  <div class="container">
    <h2 id="kontakt-band-title" class="h2 contact__title" data-reveal>Sprechen Sie uns an.</h2>
    <div class="contact__grid">
      <a href={company.phoneHref} class="contact__big" data-reveal>{company.phone}</a>
      <a href={`mailto:${company.email}`} class="contact__big contact__big--mail" data-reveal>{company.email}</a>
    </div>
    <div class="contact__foot" data-reveal>
      <p>{company.owner} · Inhaber · {company.street}, {company.zip} {company.city}</p>
      {
        showFormLink && (
          <a href="/kontakt/#anfrage" class="btn">
            Anfrage senden <Arrow />
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .contact {
    border-top: 1px solid var(--line);
  }

  .contact__title {
    margin-bottom: 2rem;
  }

  .contact__grid {
    display: grid;
    border-top: 2px solid var(--anthracite);
  }

  .contact__big {
    display: block;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--line);
    font-size: clamp(1.75rem, 1.1rem + 3vw, 3.5rem);
    font-weight: 700;
    font-stretch: 82%;
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color 0.25s var(--ease);
  }

  .contact__big--mail {
    font-size: clamp(1.4rem, 1rem + 2vw, 2.5rem);
  }

  .contact__big:hover {
    color: var(--green);
  }

  .contact__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    margin-top: 2rem;
    color: var(--text-2);
  }
</style>
