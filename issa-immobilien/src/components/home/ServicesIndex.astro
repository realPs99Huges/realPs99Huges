---
import Study from '../Study.astro';
import Arrow from '../Arrow.astro';
import { services } from '../../data/site';
---

<section class="services section surface-deep" aria-labelledby="leistungen-title">
  <div class="container grid">
    <div class="services__intro">
      <div class="services__sticky">
        <p class="eyebrow" data-reveal><span class="index">02</span> Leistungen</p>
        <h2 id="leistungen-title" class="h2 services__title" data-reveal>
          Vier Bereiche. Ein durchgängiger <em>Ansatz.</em>
        </h2>
        <p class="services__lede muted" data-reveal>
          Von der Analyse bis zur Verhandlung greifen die einzelnen Schritte ineinander – für Wohnimmobilien ebenso wie
          für gewerbliche Vorhaben.
        </p>
        <div class="services__image">
          <Study name="interior" sizes="(min-width: 60em) 30vw, 100vw" ratio="5 / 4" position="40% 60%" />
        </div>
      </div>
    </div>

    <ol class="services__list" role="list">
      {
        services.map((s, i) => (
          <li data-reveal style={`--reveal-delay:${i * 60}`}>
            <a href={`/leistungen/#${s.id}`} class="service">
              <span class="service__no">{s.no}</span>
              <span class="service__body">
                <span class="service__title">{s.title}</span>
                <span class="service__text">{s.short}</span>
              </span>
              <span class="service__more">
                <span class="visually-hidden">Mehr zu {s.title}</span>
                <Arrow />
              </span>
            </a>
          </li>
        ))
      }
    </ol>

    <div class="services__footer" data-reveal>
      <a href="/leistungen/" class="link-arrow">Alle Leistungen im Detail <Arrow class="" /></a>
    </div>
  </div>
</section>

<style>
  .services__title {
    margin-top: 1.25rem;
    max-width: 14ch;
  }

  .services__lede {
    margin-top: 1.25rem;
    max-width: 26rem;
  }

  .services__image {
    display: none;
  }

  .services__list {
    border-top: 1px solid var(--line-strong);
  }

  .services__list li {
    border-bottom: 1px solid var(--line);
  }

  .service {
    display: grid;
    grid-template-columns: 2.75rem 1fr auto;
    gap: 0.5rem 1rem;
    padding-block: 1.75rem;
    text-decoration: none;
    transition: padding 0.6s var(--ease-out);
  }

  .service__no {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--accent);
    padding-top: 0.35rem;
  }

  .service__body {
    display: grid;
    gap: 0.6rem;
  }

  .service__title {
    font-family: var(--serif);
    font-size: var(--fs-h3);
    font-weight: 380;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .service__text {
    max-width: 34rem;
    color: var(--ink-soft);
  }

  .service__more {
    align-self: start;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-top: 0.1rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    transition:
      background-color 0.4s var(--ease),
      color 0.4s var(--ease),
      border-color 0.4s var(--ease);
  }

  .service__more :global(svg) {
    width: 1rem;
  }

  .service:hover .service__more,
  .service:focus-visible .service__more {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .services__footer {
    margin-top: 0.5rem;
  }

  @media (hover: hover) and (min-width: 60em) {
    .service:hover {
      padding-left: 0.75rem;
    }
  }

  @media (min-width: 60em) {
    .services__intro {
      grid-column: 1 / span 5;
    }

    .services__sticky {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }

    .services__image {
      display: block;
      margin-top: var(--space-4);
      max-width: 26rem;
    }

    .services__list {
      grid-column: 7 / span 6;
      align-self: start;
    }

    .services__footer {
      grid-column: 7 / span 6;
    }

    .service {
      grid-template-columns: 3.5rem 1fr auto;
      padding-block: 2.25rem;
    }
  }
</style>
