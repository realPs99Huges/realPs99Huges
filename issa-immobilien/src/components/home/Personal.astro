---
import Arrow from '../Arrow.astro';
import { company, mapsUrl } from '../../data/site';
---

<section class="personal section" aria-labelledby="betreuung-title">
  <div class="container grid">
    <div class="personal__text">
      <p class="eyebrow" data-reveal><span class="index">04</span> Persönliche Betreuung</p>
      <h2 id="betreuung-title" class="h2 personal__title" data-reveal>
        Ein Ansprechpartner – <em>von Anfang an.</em>
      </h2>
      <blockquote class="personal__quote" data-reveal>
        <p>
          „Jede Immobilie bringt eigene Voraussetzungen und Ziele mit sich. Deshalb beginnt unsere Arbeit mit dem genauen
          Verständnis Ihres Anliegens – und einer Beratung, die sich an Ihrer Immobilie orientiert.“
        </p>
        <footer>
          <span class="personal__name">{company.owner}</span>
          <span class="personal__role">Inhaber, {company.name}</span>
        </footer>
      </blockquote>
    </div>

    <aside class="personal__card" aria-label="Direkter Kontakt" data-reveal>
      <p class="personal__card-label">Direkter Kontakt</p>
      <dl>
        <div>
          <dt>Telefon</dt>
          <dd><a href={company.phoneHref}>{company.phone}</a></dd>
        </div>
        <div>
          <dt>E-Mail</dt>
          <dd><a href={`mailto:${company.email}`}>{company.email}</a></dd>
        </div>
        <div>
          <dt>Büro</dt>
          <dd>
            <a href={mapsUrl} target="_blank" rel="noopener noreferrer">
              {company.street}, {company.zip} {company.city}
              <span class="visually-hidden"> (öffnet Google Maps in neuem Tab)</span>
            </a>
          </dd>
        </div>
      </dl>
      <a href="/ueber-uns/" class="link-arrow">Mehr über Issa Immobilien <Arrow class="" /></a>
    </aside>
  </div>
</section>

<style>
  .personal__title {
    margin-top: 1.25rem;
    max-width: 16ch;
  }

  .personal__quote {
    margin-top: var(--space-4);
    padding-left: 1.5rem;
    border-left: 1px solid var(--accent);
  }

  .personal__quote p {
    max-width: 36rem;
    font-family: var(--serif);
    font-size: var(--fs-h4);
    font-weight: 360;
    line-height: 1.5;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  .personal__quote footer {
    display: grid;
    gap: 0.15rem;
    margin-top: 1.5rem;
  }

  .personal__name {
    font-weight: 600;
  }

  .personal__role {
    font-size: var(--fs-sm);
    color: var(--muted);
  }

  .personal__card {
    align-self: end;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: var(--paper-deep);
    border-top: 2px solid var(--ink);
  }

  .personal__card-label {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .personal__card dl {
    margin-block: 1.25rem 1.75rem;
  }

  .personal__card dl > div {
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--line);
  }

  .personal__card dt {
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .personal__card dd {
    margin-top: 0.2rem;
    font-size: 1.0625rem;
    overflow-wrap: anywhere;
  }

  .personal__card dd a {
    text-decoration: none;
  }

  .personal__card dd a:hover {
    text-decoration: underline;
  }

  @media (min-width: 60em) {
    .personal__text {
      grid-column: 1 / span 7;
    }

    .personal__card {
      grid-column: 9 / span 4;
    }
  }
</style>
