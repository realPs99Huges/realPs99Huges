---
import ImageSlot from '../ImageSlot.astro';
import Arrow from '../Arrow.astro';
import { company } from '../../data/site';
---

<section class="hero on-dark" aria-labelledby="hero-title">
  <div class="hero__media" aria-hidden="true">
    <ImageSlot name="hero" ratio="auto" sizes="(min-width: 60em) 45vw, 100vw" priority reveal={false} class="hero__image" />
  </div>

  <div class="container hero__inner">
    <p class="hero__slogan hero__in" style="--d:100">{company.slogan}</p>
    <p class="hero__kicker hero__in" style="--d:160">Einzelhandelsimmobilien · Deutschlandweit</p>
    <h1 id="hero-title" class="hero__title hero__in" style="--d:220">
      Der richtige Standort für erfolgreichen <span>Einzelhandel.</span>
    </h1>
    <p class="hero__lead hero__in" style="--d:340">
      Issa Immobilien begleitet die Vermarktung und Vermittlung von Einzelhandelsimmobilien und gewerblichen
      Handelsstandorten – von Fachmarktzentren und großflächigen Einzelhandelsflächen bis zu geeigneten Standorten für
      Filialunternehmen.
    </p>
    <div class="hero__actions hero__in" style="--d:460">
      <a href="/kontakt/" class="btn">Kontakt aufnehmen <Arrow /></a>
      <a href="/leistungen/" class="btn btn--outline-light">Leistungen entdecken</a>
    </div>
    <p class="hero__phone hero__in" style="--d:560">
      Direkt: <a href={company.phoneHref}>{company.phone}</a>
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    margin-top: var(--header-h);
    border-bottom: 6px solid var(--green);
  }

  .hero__media {
    position: relative;
    height: 38svh;
    min-height: 15rem;
  }

  .hero__media :global(.hero__image) {
    height: 100%;
    aspect-ratio: auto;
  }

  .hero__media :global(img) {
    filter: grayscale(1) contrast(1.1);
    opacity: 0.6;
  }

  .hero__inner {
    position: relative;
    padding-block: 2.5rem 3.5rem;
  }

  .hero__slogan {
    display: inline-block;
    padding: 0.4rem 0.7rem;
    background: var(--green);
    color: var(--white);
    font-size: var(--fs-sm);
    font-weight: 650;
    letter-spacing: 0.04em;
  }

  .hero__kicker {
    margin-top: 1.5rem;
    font-size: var(--fs-xs);
    font-weight: 650;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--on-dark-2);
  }

  .hero__phone {
    margin-top: 1.5rem;
    font-size: var(--fs-sm);
    color: var(--on-dark-muted);
  }

  .hero__phone a {
    color: var(--white);
    font-weight: 620;
    text-decoration: none;
  }

  .hero__phone a:hover {
    text-decoration: underline;
    text-decoration-color: var(--green);
    text-decoration-thickness: 2px;
  }

  .hero__title {
    margin-top: 0.75rem;
    max-width: 14ch;
    font-size: clamp(2.375rem, 1.3rem + 4.6vw, 5.5rem);
    font-weight: 720;
    font-stretch: 80%;
    line-height: 0.98;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .hero__title span {
    color: var(--green);
  }

  .hero__lead {
    margin-top: 1.75rem;
    max-width: 34rem;
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--on-dark-2);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  @media (max-width: 30em) {
    .hero__actions .btn {
      flex: 1 1 100%;
    }
  }

  /* Desktop: Schrift links auf Anthrazit, Foto rechts als klare Fläche */
  @media (min-width: 60em) {
    .hero {
      min-height: min(calc(100svh - var(--header-h)), 46rem);
      display: flex;
      align-items: center;
    }

    .hero__media {
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      width: 45%;
      height: auto;
    }

    .hero__inner {
      padding-block: 5rem 6rem;
    }

    .hero__lead {
      max-width: min(52%, 34rem);
    }

    .hero__title {
      max-width: min(58%, 12ch);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__in {
      animation: hero-text 0.9s var(--ease-out) both;
      animation-delay: calc(var(--d, 0) * 1ms);
    }

    .hero__media {
      animation: hero-media 1.4s var(--ease-out) both;
    }
  }

  @keyframes hero-text {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  @keyframes hero-media {
    from {
      clip-path: inset(0 0 0 100%);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
</style>
