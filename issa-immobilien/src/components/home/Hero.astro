---
import Study from '../Study.astro';
import Arrow from '../Arrow.astro';
import { company } from '../../data/site';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__media">
    <Study
      name="residence"
      sizes="(min-width: 60em) 54vw, 100vw"
      position="62% 40%"
      caption={false}
      priority
      reveal={false}
    />
    <p class="hero__caption" aria-hidden="true">Abb. 01 — Studie Wohnhaus · Visualisierung</p>
  </div>

  <div class="container hero__inner">
    <div class="hero__text">
      <p class="eyebrow hero__in" style="--d:250">Immobilienvermarktung <span aria-hidden="true">·</span> Lippstadt</p>
      <h1 id="hero-title" class="hero__title hero__in" style="--d:380">
        Jede Immobilie hat eine Geschichte. Wir geben ihr die richtige <em>Perspektive.</em>
      </h1>
      <p class="lead hero__lead hero__in" style="--d:560">
        Von der ersten Einschätzung bis zur Übergabe begleiten wir Sie mit persönlicher Beratung, einem klaren
        Konzept und dem Blick für das, was Ihre Immobilie ausmacht.
      </p>
      <div class="hero__actions hero__in" style="--d:700">
        <a href="/kontakt/" class="btn">Gespräch vereinbaren <Arrow /></a>
        <a href="/leistungen/" class="btn btn--ghost">Unsere Leistungen</a>
      </div>
    </div>

    <div class="hero__meta hero__in" style="--d:900">
      <p>
        <span class="hero__meta-label">Direkt erreichbar</span>
        <a href={company.phoneHref}>{company.phone}</a>
      </p>
      <p class="hero__coords" aria-hidden="true">51° 40′ N · 8° 21′ O</p>
      <a href="#haltung" class="hero__scroll">
        <span class="visually-hidden">Weiter zum nächsten Abschnitt</span>
        <span class="hero__scroll-line" aria-hidden="true"></span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .hero__media {
    position: relative;
    height: 56svh;
    min-height: 22rem;
    max-height: 40rem;
  }

  .hero__media :global(.study),
  .hero__media :global(.study__frame) {
    height: 100%;
  }

  .hero__caption {
    display: none;
  }

  .hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    padding-top: 2.25rem;
    padding-bottom: 2.5rem;
  }

  .hero__text {
    max-width: 40rem;
  }

  .hero__title {
    margin-top: 1.25rem;
    font-family: var(--serif);
    font-size: clamp(2.125rem, 1.25rem + 2.75vw, 3.875rem);
    font-weight: 370;
    line-height: 1.06;
    letter-spacing: -0.022em;
    text-wrap: balance;
  }

  .hero__title em {
    font-weight: 340;
  }

  .hero__lead {
    margin-top: 1.5rem;
    max-width: 31rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .hero__meta {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-size: var(--fs-sm);
  }

  .hero__meta a {
    text-decoration: none;
  }

  .hero__meta a:hover {
    text-decoration: underline;
  }

  .hero__meta-label {
    display: block;
    font-size: var(--fs-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .hero__coords {
    display: none;
    font-family: var(--serif);
    font-style: italic;
    color: var(--muted);
  }

  .hero__scroll {
    display: none;
  }

  @media (max-width: 30em) {
    .hero__actions .btn {
      flex: 1 1 100%;
    }
  }

  /* Desktop: asymmetrisches Raster, Bild läuft bis an den rechten Rand */
  @media (min-width: 60em) {
    .hero {
      min-height: max(40rem, min(100svh, 60rem));
    }

    .hero__media {
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      width: 54vw;
      height: auto;
      max-height: none;
    }

    .hero__caption {
      display: block;
      position: absolute;
      left: -2.25rem;
      bottom: 0;
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      font-size: var(--fs-xs);
      letter-spacing: 0.06em;
      color: var(--muted);
    }

    .hero__inner {
      flex: 1;
      justify-content: space-between;
      padding-top: calc(var(--header-h) + clamp(2.5rem, 8vh, 6rem));
      padding-bottom: 2.25rem;
    }

    .hero__text {
      width: calc(46vw - var(--gutter) - 4.5rem);
      max-width: 38rem;
    }

    .hero__meta {
      width: calc(46vw - var(--gutter) - 4.5rem);
      max-width: 38rem;
    }

    .hero__coords {
      display: block;
    }

    .hero__scroll {
      display: block;
      position: relative;
      width: 1px;
      height: 3.5rem;
      background: var(--line);
      overflow: hidden;
    }

    .hero__scroll::before {
      content: '';
      position: absolute;
      inset: -0.5rem -1rem;
    }

    .hero__scroll-line {
      position: absolute;
      left: 0;
      top: 0;
      width: 1px;
      height: 40%;
      background: var(--ink);
    }
  }

  /* Eingangsanimation – ruhig, kurz, ohne Ladebildschirm */
  @media (prefers-reduced-motion: no-preference) {
    .hero__media :global(.study__frame) {
      animation: hero-reveal 1.6s var(--ease-out) both;
    }

    .hero__media :global(img) {
      animation: hero-settle 2.4s var(--ease-out) both;
    }

    .hero__in {
      animation: hero-text 1.1s var(--ease-out) both;
      animation-delay: calc(var(--d, 0) * 1ms);
    }

    .hero__scroll-line {
      animation: hero-scroll 2.6s var(--ease) 2s infinite;
    }
  }

  @keyframes hero-reveal {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes hero-settle {
    from {
      transform: scale(1.07);
    }
    to {
      transform: none;
    }
  }

  @keyframes hero-text {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  @keyframes hero-scroll {
    0% {
      transform: translateY(-100%);
    }
    60%,
    100% {
      transform: translateY(260%);
    }
  }
</style>
