---
import ImageSlot from '../ImageSlot.astro';
import Arrow from '../Arrow.astro';
import { company, assetClasses } from '../../data/site';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__text">
      <p class="hero__slogan hero__in" style="--d:100">{company.slogan}</p>
      <p class="eyebrow hero__in" style="--d:150">Einzelhandelsimmobilien · Deutschlandweit</p>
      <h1 id="hero-title" class="h1 hero__title hero__in" style="--d:260">
        Der richtige Standort für erfolgreichen <span class="accent">Einzelhandel.</span>
      </h1>
      <p class="lead hero__lead hero__in" style="--d:400">
        Issa Immobilien begleitet die Vermarktung und Vermittlung von Einzelhandelsimmobilien und gewerblichen
        Handelsstandorten – von Fachmarktzentren und großflächigen Einzelhandelsflächen bis zu geeigneten Standorten
        für Filialunternehmen.
      </p>
      <div class="hero__actions hero__in" style="--d:520">
        <a href="/kontakt/" class="btn">Kontakt aufnehmen <Arrow /></a>
        <a href="/leistungen/" class="btn btn--outline">Leistungen entdecken</a>
      </div>
      <dl class="hero__facts hero__in" style="--d:640">
        <div>
          <dt>Tätigkeitsgebiet</dt>
          <dd>Ganz Deutschland</dd>
        </div>
        <div>
          <dt>Sitz</dt>
          <dd>{company.city}</dd>
        </div>
        <div>
          <dt>Direkt</dt>
          <dd><a href={company.phoneHref}>{company.phone}</a></dd>
        </div>
      </dl>
    </div>

    <div class="hero__media">
      <span class="hero__block" aria-hidden="true"></span>
      <ImageSlot name="hero" ratio="4 / 3" sizes="(min-width: 60em) 46vw, 100vw" priority reveal={false} class="hero__image" />
      <p class="hero__seal">
        <span class="hero__seal-text">{company.slogan}</span>
        <span class="hero__seal-sub">für Einzelhandelsimmobilien</span>
      </p>
    </div>
  </div>

  <div class="hero__market">
    <div class="container">
      <p class="visually-hidden">Schwerpunkte:</p>
      <ul role="list" class="hero__market-list">
        {assetClasses.slice(0, 6).map((a) => <li>{a.title}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: calc(var(--header-h) + clamp(2rem, 6vw, 4.5rem));
  }

  .hero__grid {
    display: grid;
    gap: 3rem;
    align-items: center;
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  /* Spruch auf dem Smartphone direkt sichtbar; ab Desktop als Siegel am Bild */
  .hero__slogan {
    margin-bottom: 1.25rem;
    padding-left: 0.75rem;
    border-left: 3px solid var(--green);
    line-height: 1.15;
    font-size: 1.25rem;
    font-weight: 680;
    font-stretch: 88%;
    letter-spacing: -0.01em;
    color: var(--slate);
  }

  .hero__title {
    margin-top: 1.5rem;
    max-width: 15ch;
  }

  .hero__lead {
    margin-top: 1.5rem;
    max-width: 36rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2.5rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .hero__facts dt {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .hero__facts dd {
    margin-top: 0.2rem;
    font-weight: 600;
  }

  .hero__facts a {
    text-decoration: none;
  }

  .hero__facts a:hover {
    color: var(--green-strong);
  }

  /* Bildkomposition: Foto, Anthrazit-Fläche, Linien aus dem Logo */
  .hero__media {
    position: relative;
    margin-right: calc(-1 * var(--gutter));
    padding: 0 0 1.5rem 1.5rem;
  }

  .hero__block {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 62%;
    height: 72%;
    background: var(--anthracite);
  }


  .hero__media :global(.hero__image) {
    position: relative;
  }

  /* Siegel mit dem Markenspruch */
  .hero__seal {
    position: absolute;
    right: var(--gutter);
    bottom: -0.5rem;
    z-index: 1;
    display: none;
    gap: 0.2rem;
    padding: 1rem 1.25rem 1.1rem;
    background: var(--white);
    border-top: 4px solid var(--green);
    box-shadow: 0 12px 32px -18px rgb(42 42 42 / 0.45);
  }

  .hero__seal-text {
    font-size: clamp(1.25rem, 1.05rem + 0.9vw, 1.75rem);
    font-weight: 680;
    font-stretch: 88%;
    line-height: 1.05;
    letter-spacing: -0.01em;
  }

  .hero__seal-sub {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green-strong);
  }

  .hero__market {
    background: var(--anthracite);
    color: var(--on-dark);
  }

  .hero__market-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    padding-block: 1.25rem;
    font-size: var(--fs-sm);
    font-weight: 560;
    letter-spacing: 0.01em;
  }

  .hero__market-list li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .hero__market-list li::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    background: var(--green);
  }

  @media (max-width: 30em) {
    .hero__actions .btn {
      flex: 1 1 100%;
    }
  }

  @media (min-width: 60em) {
    .hero__grid {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: clamp(2rem, 5vw, 5rem);
    }

    .hero__media {
      margin-right: 0;
      padding: 0 0 2rem 2rem;
    }

    .hero__slogan {
      display: none;
    }

    .hero__seal {
      display: grid;
      right: auto;
      left: -1.5rem;
      bottom: 3.5rem;
      padding: 1.25rem 1.6rem 1.35rem;
    }

    .hero__market-list {
      justify-content: space-between;
    }
  }

  /* Eingangsanimation: ruhig und kurz */
  @media (prefers-reduced-motion: no-preference) {
    .hero__in {
      animation: hero-text 0.9s var(--ease-out) both;
      animation-delay: calc(var(--d, 0) * 1ms);
    }

    .hero__media :global(.hero__image) {
      animation: hero-image 1.3s var(--ease-out) 0.25s both;
    }

    .hero__media :global(.hero__image img) {
      animation: hero-settle 1.8s var(--ease-out) 0.25s both;
    }

    .hero__block {
      animation: hero-block 1.1s var(--ease-out) 0.1s both;
    }

    .hero__seal {
      animation: hero-text 0.9s var(--ease-out) 0.9s both;
    }
  }

  @keyframes hero-text {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  @keyframes hero-image {
    from {
      clip-path: inset(0 0 0 100%);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes hero-settle {
    from {
      transform: scale(1.06);
    }
  }

  @keyframes hero-block {
    from {
      transform: scaleY(0);
      transform-origin: bottom;
    }
    to {
      transform-origin: bottom;
    }
  }

</style>
