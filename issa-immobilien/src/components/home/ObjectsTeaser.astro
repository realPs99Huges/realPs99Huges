---
import Study from '../Study.astro';
import Arrow from '../Arrow.astro';
---

<section class="objects" aria-labelledby="objekte-title">
  <div class="objects__media">
    <Study name="horizon" sizes="100vw" ratio="16 / 9" position="60% 50%" caption={false} />
  </div>

  <div class="container objects__inner">
    <div class="objects__panel" data-reveal>
      <p class="eyebrow"><span class="index">05</span> Objekte</p>
      <h2 id="objekte-title" class="h2 objects__title">
        Jede Vermarktung beginnt mit einem <em>Gespräch.</em>
      </h2>
      <p class="objects__text">
        Sie möchten eine Immobilie anbieten oder sind auf der Suche nach einem passenden Objekt? Schildern Sie uns Ihr
        Anliegen. Ob aktuell passende Angebote verfügbar sind, besprechen wir gern persönlich mit Ihnen.
      </p>
      <div class="objects__actions">
        <a href="/kontakt/?anliegen=verkauf" class="btn">Immobilie anbieten <Arrow /></a>
        <a href="/kontakt/?anliegen=suche" class="btn btn--ghost">Immobilie suchen</a>
      </div>
    </div>
    <p class="objects__caption">Abb. 05 — Wohnhaus mit Mauer · Zeichnung</p>
  </div>
</section>

<style>
  .objects {
    position: relative;
    padding-bottom: var(--space-6);
  }

  .objects__media :global(.study__frame) {
    aspect-ratio: 4 / 3;
  }

  .objects__inner {
    position: relative;
  }

  .objects__panel {
    position: relative;
    margin-top: -4rem;
    margin-right: 1rem;
    padding: 2rem 1.5rem 2.25rem;
    background: var(--paper);
  }

  .objects__title {
    margin-top: 1.25rem;
    max-width: 14ch;
  }

  .objects__text {
    margin-top: 1.25rem;
    max-width: 32rem;
    color: var(--ink-soft);
  }

  .objects__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .objects__caption {
    margin-top: 1rem;
    font-size: var(--fs-xs);
    color: var(--muted);
  }

  @media (min-width: 48em) {
    .objects__media :global(.study__frame) {
      aspect-ratio: 16 / 9;
      max-height: 82svh;
      width: 100%;
    }
  }

  @media (min-width: 60em) {
    .objects__panel {
      width: min(40rem, 50%);
      margin-top: -16rem;
      margin-right: 0;
      padding: 3rem 3.5rem 3.25rem 0;
    }

    .objects__panel::before {
      /* Panel optisch bis zum linken Bildrand fortführen */
      content: '';
      position: absolute;
      inset: 0 100% 0 auto;
      width: 50vw;
      background: var(--paper);
    }

    .objects__caption {
      /* Panel zieht den Container per negativem Rand 16rem nach oben */
      position: absolute;
      top: 17rem;
      right: var(--gutter);
      margin: 0;
    }
  }
</style>
