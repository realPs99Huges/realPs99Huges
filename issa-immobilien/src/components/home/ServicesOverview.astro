---
import Arrow from '../Arrow.astro';
import { services } from '../../data/site';
---

<section class="services section" aria-labelledby="leistungen-title">
  <div class="container">
    <header class="services__head">
      <div>
        <p class="eyebrow" data-reveal>Leistungen</p>
        <h2 id="leistungen-title" class="h2 services__title" data-reveal>
          Vier Leistungsbereiche rund um <span class="accent">Handelsimmobilien.</span>
        </h2>
      </div>
      <p class="lead services__lead" data-reveal>
        Von der Einordnung einer Einzelhandelsimmobilie bis zur Begleitung der Vertragsverhandlungen – strukturiert und
        mit einem festen Ansprechpartner.
      </p>
    </header>

    <ol class="services__grid" role="list">
      {
        services.map((s, i) => (
          <li data-reveal style={`--reveal-delay:${i * 80}`}>
            <a href={`/leistungen/#${s.id}`} class="service">
              <span class="service__no num">{s.no}</span>
              <h3 class="h3 service__title">{s.title}</h3>
              <p class="service__text">{s.short}</p>
              <span class="service__more">
                Mehr erfahren <Arrow class="" />
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .services__head {
    display: grid;
    gap: 1.5rem;
    margin-bottom: var(--space-5);
  }

  .services__title {
    margin-top: 1.25rem;
    max-width: 16ch;
  }

  .services__lead {
    max-width: 30rem;
    align-self: end;
  }

  .services__grid {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .services__grid li {
    border-bottom: 1px solid var(--line);
  }

  .service {
    position: relative;
    display: grid;
    gap: 0.75rem;
    height: 100%;
    padding: 2rem 0 2.25rem;
    text-decoration: none;
  }

  /* Grüne Linie wächst beim Überfahren – wie ein Strich aus dem Logo */
  .service::before {
    content: '';
    position: absolute;
    left: 0;
    top: -1px;
    width: 100%;
    height: 3px;
    background: var(--green);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease-out);
  }

  .service:hover::before,
  .service:focus-visible::before {
    transform: scaleX(1);
  }

  .service__no {
    font-size: var(--fs-sm);
  }

  .service__title {
    max-width: 18ch;
  }

  .service__text {
    max-width: 30rem;
    color: var(--text-2);
  }

  .service__more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    font-size: var(--fs-sm);
    font-weight: 620;
    color: var(--green-strong);
    transition: gap 0.4s var(--ease-out);
  }

  .service__more :global(svg) {
    width: 1rem;
  }

  .service:hover .service__more {
    gap: 0.8rem;
  }

  @media (min-width: 48em) {
    .services__grid {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--gutter);
    }
  }

  @media (min-width: 60em) {
    .services__head {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--gutter);
    }

    .service {
      padding: 2.5rem 2rem 2.75rem 0;
    }
  }
</style>
