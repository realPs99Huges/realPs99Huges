---
import { process } from '../data/site';
---

<section class="process section" aria-labelledby="ablauf-title">
  <div class="container">
    <div class="process__head">
      <h2 id="ablauf-title" class="h2" data-reveal>Zusammenarbeit</h2>
      <p class="process__note" data-reveal>
        Allgemeiner Ablauf – im Einzelfall richtet er sich nach Immobilie und Vorhaben.
      </p>
    </div>
    <ol class="process__steps" role="list">
      {
        process.map((step, i) => (
          <li class="process__step" data-reveal style={`--reveal-delay:${i * 70}`}>
            <span class="process__no" aria-hidden="true">{i + 1}</span>
            <h3 class="process__title">
              <span class="visually-hidden">Schritt {i + 1}: </span>
              {step.title}
            </h3>
            <p class="process__text">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-bottom: 2rem;
  }

  .process__note {
    max-width: 28rem;
    font-size: var(--fs-sm);
    color: var(--muted);
  }

  .process__steps {
    display: grid;
    border-top: 2px solid var(--anthracite);
  }

  .process__step {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.25rem 1rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .process__no {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    background: linear-gradient(var(--green), var(--green)) left / 100% 100% no-repeat, var(--white);
    border: 2px solid var(--green);
    color: var(--white);
    font-weight: 700;
    transition:
      background-size 0.8s var(--ease-out) calc(var(--reveal-delay, 0) * 1ms + 200ms),
      color 0.6s var(--ease) calc(var(--reveal-delay, 0) * 1ms + 300ms);
    font-variant-numeric: tabular-nums;
  }

  .process__title {
    font-size: var(--fs-h4);
    font-weight: 600;
    line-height: 1.25;
  }

  /* Nummernfeld füllt sich beim Erscheinen mit Grün */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .process__step:not(.is-visible) .process__no {
      background-size: 0% 100%;
      color: var(--green);
    }
  }

  .process__text {
    color: var(--text-2);
    font-size: 0.9375rem;
  }

  @media (min-width: 64em) {
    .process__steps {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      border-top: 0;
    }

    .process__step {
      grid-template-columns: 1fr;
      align-content: start;
      gap: 0.75rem;
      padding: 0 1.5rem 0 0;
      border-bottom: 0;
      border-top: 2px solid var(--anthracite);
      padding-top: 1.5rem;
    }

    .process__no {
      grid-row: auto;
    }
  }
</style>
