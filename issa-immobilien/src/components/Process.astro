---
import { process } from '../data/site';

interface Props {
  headingId?: string;
  surface?: boolean;
}
const { headingId = 'ablauf-title', surface = false } = Astro.props;
---

<section class:list={['process section', surface && 'surface']} aria-labelledby={headingId}>
  <div class="container">
    <header class="process__head">
      <p class="eyebrow" data-reveal>Zusammenarbeit</p>
      <h2 id={headingId} class="h2 process__title" data-reveal>
        So läuft die <span class="accent">Zusammenarbeit</span> ab.
      </h2>
      <p class="process__note muted" data-reveal>
        Allgemeine Darstellung der Arbeitsweise. Der konkrete Ablauf richtet sich nach Immobilie und Vorhaben und wird
        individuell abgestimmt.
      </p>
    </header>

    <ol class="process__steps" role="list">
      {
        process.map((step, i) => (
          <li class="process__step" data-reveal style={`--reveal-delay:${i * 90}`}>
            <span class="process__no num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="h4 process__step-title">
              <span class="visually-hidden">Schritt {i + 1}: </span>
              {step.title}
            </h3>
            <p class="process__text">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process__head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: var(--space-5);
  }

  .process__title {
    max-width: 18ch;
  }

  .process__note {
    max-width: 34rem;
    font-size: var(--fs-sm);
  }

  .process__steps {
    display: grid;
    counter-reset: step;
  }

  .process__step {
    position: relative;
    display: grid;
    gap: 0.5rem;
    padding: 0 0 2.25rem 3.5rem;
  }

  /* Verbindungslinie: vertikal auf dem Smartphone, horizontal ab Desktop */
  .process__step::before {
    content: '';
    position: absolute;
    left: 1.0625rem;
    top: 2.5rem;
    bottom: 0.25rem;
    width: 2px;
    background: var(--line);
  }

  .process__step:last-child::before {
    display: none;
  }

  .process__no {
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 2px solid var(--green);
    background: var(--white);
    font-size: var(--fs-sm);
  }

  :global(.surface) .process__no {
    background: var(--surface);
  }

  .process__step-title {
    padding-top: 0.3rem;
  }

  .process__text {
    color: var(--text-2);
    font-size: 0.9375rem;
    max-width: 30rem;
  }

  @media (min-width: 64em) {
    .process__head {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
      gap: var(--gutter);
    }

    .process__head .eyebrow {
      grid-column: 1 / -1;
    }

    .process__steps {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1.5rem;
    }

    .process__step {
      padding: 3.5rem 0 0;
      align-content: start;
    }

    .process__step::before {
      left: 2.75rem;
      right: -1.25rem;
      top: 1.0625rem;
      bottom: auto;
      width: auto;
      height: 2px;
    }

    @media (prefers-reduced-motion: no-preference) {
      .process__step::before {
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.9s var(--ease-out) calc(var(--reveal-delay, 0) * 1ms + 300ms);
      }

      :global(.js) .process__step.is-visible::before,
      :global(html:not(.js)) .process__step::before {
        transform: scaleX(1);
      }
    }
  }
</style>
